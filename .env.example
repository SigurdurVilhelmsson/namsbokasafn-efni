# Pipeline tools — environment template (repo root)
# Copy this file to .env at the repo root and fill in the values.
#
# The editorial server does NOT read this file: it runs from server/ and loads
# only server/.env, whose template is server/.env.example. A tool reads a key
# from here only when that key is not already set in the environment.
# server/__tests__/envExampleCensus.test.js fails if a key below stops being read.

# Málstaður machine-translation API key from Miðeind (https://api.malstadur.is/).
# Read by tools/api-translate.js, tools/translate-chapter-titles.js,
# tools/test-glossary-comparison.js and the figure-text experiments.
MALSTADUR_API_KEY=

# Anthropic API key for the AI-review harness (tools/ai-review/).
ANTHROPIC_API_KEY=

# Anthropic workspace id for the AI-review harness (Optional: a workspace-scoped
# key needs none).
# ANTHROPIC_WORKSPACE_ID=
