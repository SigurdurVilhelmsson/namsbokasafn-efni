# Translation Pipeline API Server - Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Server Configuration
# =============================================================================

# Server port (default: 3000)
PORT=3000

# Server host (default: localhost)
HOST=localhost

# Base URL for links in emails (default: http://localhost:3000)
BASE_URL=https://ritstjorn.namsbokasafn.is

# =============================================================================
# CORS Configuration
# =============================================================================

# Additional allowed origins (comma-separated, optional)
# The following are always allowed: namsbokasafn.is, localhost:5173, localhost:4173, localhost:3000
CORS_ORIGIN=

# =============================================================================
# Microsoft Entra ID OAuth (required for authentication)
# =============================================================================

# Microsoft Entra ID (Azure AD) app registration.
# Create at: https://portal.azure.com/ -> App registrations
# With NODE_ENV=production the server REFUSES TO START unless JWT_SECRET,
# MS_CLIENT_ID, MS_CLIENT_SECRET and MS_TENANT_ID are all set
# (server/config.js, REQUIRED_PRODUCTION_SECRETS).
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Directory (tenant) ID. Defaults to 'common' when unset.
MS_TENANT_ID=

# OAuth redirect URI. Falls back to CALLBACK_URL, then to
# http://localhost:3000/api/auth/callback
MS_CALLBACK_URL=

# Comma-separated Microsoft emails granted admin access (optional)
ADMIN_USERS=

# JWT secret for session tokens (generate a secure random string, >= 32 chars)
JWT_SECRET=

# Session token lifetime (default: 24h)
JWT_EXPIRY=

# =============================================================================
# Email Notifications (optional but recommended for pilot)
# =============================================================================

# Admin email for receiving feedback notifications
ADMIN_EMAIL=

# SMTP server configuration
# Required for sending email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@namsbokasafn.is


# =============================================================================
# External Services (optional)
# =============================================================================

# OpenStax archive URL (default: built-in)
OPENSTAX_ARCHIVE_URL=https://openstax.org/apps/archive

# =============================================================================
# Málstaður Translation API (optional - for automated MT)
# =============================================================================

# API key from Miðeind (https://api.malstadur.is/)
MALSTADUR_API_KEY=
