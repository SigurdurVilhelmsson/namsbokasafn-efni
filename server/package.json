{
  "name": "namsbokasafn-pipeline-server",
  "version": "2.0.0",
  "description": "Translation pipeline automation server for OpenStax content",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.js",
    "test:e2e:headed": "npx playwright test --config=e2e/playwright.config.js --headed",
    "test:e2e:debug": "npx playwright test --config=e2e/playwright.config.js --debug"
  },
  "overrides": {
    "glob": ">=11.0.0",
    "minimatch": ">=10.2.3",
    "brace-expansion": ">=5.0.8",
    "body-parser": ">=2.3.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "openstax",
    "translation",
    "pipeline",
    "api"
  ],
  "author": "Sigurður E. Vilhelmsson",
  "license": "SEE LICENSE FILE",
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
