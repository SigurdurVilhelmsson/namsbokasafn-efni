# Ritstjóri (the editorial server) — environment template
# Copy this file to server/.env and fill in the values.
#
# The server runs from server/ and loads only server/.env; the repo-root .env is
# for the pipeline tools. Every variable below is read by the running server, and
# server/__tests__/envExampleCensus.test.js fails if one is added to or dropped
# from the code without this file following. Defaults live where each variable is
# read (most in config.js). The cron scripts (backups, glossary export) do NOT
# load this file.

# Server Configuration
PORT=3000
# Bind address; config.js lists the values it accepts
HOST=localhost
# "production" turns on the startup secret checks (config.js)
NODE_ENV=development
# Log level: debug, info, warn or error (lib/logger.js)
# LOG_LEVEL=info

# Microsoft Entra ID (Azure AD) Authentication
# Register an app at: https://portal.azure.com > App registrations
# Redirect URI: https://ritstjorn.namsbokasafn.is/api/auth/callback (type: Web)
# API permissions: openid, profile, email, User.Read (Microsoft Graph, delegated)
# With NODE_ENV=production the server refuses to start unless every variable in
# REQUIRED_PRODUCTION_SECRETS (config.js) is set.
MS_CLIENT_ID=your_client_id_here
MS_CLIENT_SECRET=your_client_secret_here
MS_TENANT_ID=your_tenant_id_here
MS_CALLBACK_URL=http://localhost:3000/api/auth/callback
# Older name for the same setting, read only when MS_CALLBACK_URL is unset:
# CALLBACK_URL=

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRY=24h

# Admin Users (comma-separated Microsoft email addresses that get admin access)
ADMIN_USERS=

# Sign-ins that match no account (AUTO_CREATE_USERS; read by signInPolicy in services/auth.js):
#   unset (the default) → a visitor: can look around, cannot change anything, and gets
#                         no account row, so visits never fill the admin page's list
#   true                → a viewer account on each first sign-in (the behaviour before 2026-10-24)
#   false               → refused; only people who already have an account (added by an
#                         admin, or created earlier) and ADMIN_USERS can sign in
# Any other value is refused too, with a warning in the log. To let someone join, add the
# address their profile page (Um mig) shows on the admin page: it is their Microsoft `mail`
# address, which can differ from the one they type to sign in. Their next sign-in links to it.
# AUTO_CREATE_USERS=

# CORS Configuration (Optional): comma-separated extra allowed origins (lib/corsOptions.js)
# CORS_ORIGIN=http://localhost:3000

# Rate limits (Optional; config.js)
# RATE_LIMIT_WINDOW_MS=
# RATE_LIMIT_MAX=
# RATE_LIMIT_AUTH_MAX=

# Log a request slower than this many milliseconds (Optional; middleware/requestTiming.js)
# SLOW_REQUEST_MS=

# Email Notifications (Optional). Mail is off unless SMTP_HOST, SMTP_USER and
# SMTP_PASS are all set (isEmailConfigured in services/notifications.js).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Námsbókasafn <notifications@namsbokasafn.is>
# SMTP_SECURE=false
# Base URL for links in emails
# BASE_URL=https://ritstjorn.namsbokasafn.is
# Recipient of feedback notifications
# ADMIN_EMAIL=

# Icelandic grammar checker (Optional; see greynir-sidecar/README.md). Unset means
# the QA layer reports no grammar findings.
# GREYNIR_URL=http://127.0.0.1:5119

# When GET /api/health calls a heartbeat stale (Optional). The defaults are in the
# health modules under lib/ and are derived from the cron schedules; change them
# only together with the schedules.
# OFFBOX_BACKUP_STALE_HOURS=
# CONTENT_BACKUP_STALE_HOURS=
# GLOSSARY_EXPORT_STALE_HOURS=
# GLOSSARY_REFUSAL_STALE_DAYS=

# Database location (lib/dbPath.js). Do NOT set this here on a real install: the
# backup and export cron jobs do not load this file, so they would keep using the
# default database while the server wrote another. Tests set it in their own
# environment.
# SESSIONS_DB_PATH=
