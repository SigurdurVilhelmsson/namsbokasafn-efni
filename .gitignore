# CodeGraph index — machine-local, regenerated by indexing; never committed.
# CodeGraph writes its own .codegraph/.gitignore containing "* / !.gitignore",
# which already covers the 37 MB database — but the "!" un-ignores that file
# itself, so `git add -A` would commit it and `git status` shows ?? .codegraph/
# forever. This entry covers the directory as a whole, and unlike the tool's own
# file it survives the tool changing or the directory being rebuilt.
.codegraph/

# Logs
*.log
npm-debug.log*

# Build output
dist/
build/

# Licensed data files (BÍN, etc.) — download separately per license terms
tools/data/

# Pipeline runtime output (sessions database, processed files)
pipeline-output/

# Test coverage
coverage/

# Playwright
server/test-results/
server/playwright-report/

