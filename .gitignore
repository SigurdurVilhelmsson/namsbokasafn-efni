books/liffraedi-2e/01-source/media/

# Tooling state (Superpowers / Claude Code workflows)
.superpowers/
.claude/workflows/

# Personal Claude Code permissions — machine-local, may contain allowlisted
# commands. These files have carried live API tokens inside permission strings
# (namsbokasafn-vefur leaked two Cloudflare tokens this way, 2025-12-30), so
# they must never be tracked. Repo-level rule on purpose: a global
# ~/.config/git/ignore does not travel with a clone, so it protects neither
# collaborators nor the production checkout.
.claude/settings.local.json
.claude/*.local.json

# Python bytecode
__pycache__/
*.pyc

# Ad-hoc pre-fix content backups (real history lives in git)
*.pre-equation-fix-*

# E2E fixture book: inputs are committed, test-written outputs are not
books/__e2e-fixture__/03-faithful-translation/
books/__e2e-fixture__/03-translated/
books/__e2e-fixture__/04-localized-content/
books/__e2e-fixture__/05-publication/
books/__e2e-fixture__/tm/

# SVG image-localization holding areas (orphans / reverted-to-jpg / pending Cowork re-export)
books/*/media/_orphans/
books/*/media/_reverted/
books/*/media/_reexport-pending/
books/*/media/_broken/
books/*/media/_suspect/

# Aligned research-corpus export (item 20) — regenerable from pipeline tiers
books/*/corpus/

# B1 glossary probe output (paid run artifacts; regenerate via docs/audit/b1-glossary-probe.mjs)
docs/audit/probe-out/

# E2E lock residue. `*.locked` files are LEGITIMATELY TRACKED for real books
# (efnafraedi-2e, liffraedi-2e — a lock is part of that content's state), so this
# is deliberately scoped to the throwaway fixture and must NOT be widened.
# Playwright's editor specs acquire module locks and a run that is interrupted —
# or a webServer killed to free port 3456 — leaves them behind, at which point
# any `git add -A` commits test residue into 02-mt-output/, a READ-ONLY tree.
# Observed 2026-08-11: exactly that, caught in the commit's own file list.
books/__e2e-fixture__/**/*.locked

# Scratch TMPDIR — must never be committed. A git-backup test commits from its
# own cwd, so a TMPDIR inside the worktree lets it commit into YOUR branch.
.tmp-install/
