+def run_face(run):
+    """(bold, italic, is_liberation) from the run's OWN BaseFont - never the resource name.
+    Same predicate as scratchpad/tools/runexact_png.py:face_of (1a's ceiling)."""
+    base = meta['fonts'].get(run['font'], {}).get('base', '').split('+')[-1].lower()
+    return ('bold' in base, 'italic' in base or 'oblique' in base, 'liberation' in base)
+
+
+def draw_run_exact(b, bi):
+    """Draw every run of block `b` at its own origin, size, rotation, fill and face.
+    Nothing is joined, wrapped, re-anchored, re-led or re-sized.  Returns True when a
+    pdfminer (cid:N) placeholder was removed from any run (and ONLY then - no .strip(),
+    which would move glyphs inside a run and is what mis-reports edge-space lines)."""
+    changed = False
+    for r in b:
+        text = FT._CID_TOKEN.sub('', r['text'])
+        changed |= text != r['text']
+        if text == '':
+            continue
+        bold, italic, _lib = run_face(r)
+        rot = r['rot']
+        px, py = dev(r['x'], r['y'])
+        col = cmyk(r['fill'])
+        ITEMS.append(dict(text=text, x=px / S, y=H_PT - py / S, rot=rot, size=r['size'],
+                          bold=bold, italic=italic, rgb=col, dx=0.0, block=bi, path='runexact'))
+        ctx.select_font_face(FAMILY,
+                             cairo.FONT_SLANT_ITALIC if italic else cairo.FONT_SLANT_NORMAL,
+                             cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
+        ctx.set_font_size(r['size'] * S)
+        ctx.save(); ctx.translate(px, py); ctx.rotate(-math.radians(rot))
+        ctx.set_source_rgb(*col); ctx.move_to(0, 0); ctx.show_text(text)
+        ctx.restore()
+    return changed
+
 
