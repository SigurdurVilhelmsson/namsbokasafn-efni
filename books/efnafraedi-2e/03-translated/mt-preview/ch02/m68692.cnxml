<entry align="center">1,602 <m:math><m:mrow><m:mo>×</m:mo></m:mrow></m:math>10<sup>−19</sup></entry>
<entry align="center">1+</entry>
<entry align="center">1,00727</entry>
<entry align="center">1,67262 <m:math><m:mrow><m:mo>×</m:mo></m:mrow></m:math> 10<sup>−24</sup></entry>
</row>
<row valign="top">
<entry align="center">nifteind</entry>
<entry align="center">kjarni</entry>
<entry align="center">0</entry>
