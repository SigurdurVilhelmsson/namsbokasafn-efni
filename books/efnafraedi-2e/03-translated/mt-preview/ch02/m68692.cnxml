<colspec colnum="2" colname="c2"/>
<colspec colnum="3" colname="c3"/>
<colspec colnum="4" colname="c4"/>
<colspec colnum="5" colname="c5"/>
<colspec colnum="6" colname="c6"/>
<thead>
<row>
<entry namest="c1" nameend="c6" align="center">Eiginleikar undiratómagna</entry>
</row>
<row valign="top">
<entry align="center">Nafn</entry><entry align="center">Staðsetning</entry><entry align="center">Hleðsla (C)</entry><entry align="center">Einingarhleðsla</entry><entry align="center">Massi (amu)</entry><entry align="center">Massi (g)</entry>
</row>
