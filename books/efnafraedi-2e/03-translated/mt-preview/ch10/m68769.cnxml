<entry align="left">koltvísýringur</entry>
<entry align="left">31,1</entry>
<entry align="left">7400</entry>
</row>
<row valign="top">
<entry align="left">ammóníak</entry>
<entry align="left">132,4</entry>
<entry align="left">11.300</entry>
</row>
<row valign="top">
<entry align="left">brennisteinsdíoxíð</entry>
<entry align="left">157,2</entry>
<entry align="left">7800</entry>
