</row>
<row valign="top">
<entry align="center">H</entry>
<entry align="center">1,008</entry>
<entry align="center">1,008</entry>
<entry align="center">6,022 <m:math><m:mo>×</m:mo></m:math> 10<sup>23</sup></entry>
</row>
<row valign="top">
<entry align="center">O</entry>
<entry align="center">16,00</entry>
<entry align="center">16,00</entry>
<entry align="center">6,022 <m:math><m:mo>×</m:mo></m:math> 10<sup>23</sup></entry></row>
<row valign="top">
<entry align="center">Na</entry>
<entry align="center">22,99</entry>
<entry align="center">22,99</entry>
