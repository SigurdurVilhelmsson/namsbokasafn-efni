<entry align="left">magn sýnis sem verður fyrir 3,7 <m:math><m:mo>×</m:mo></m:math> 10<sup>10</sup> sundrunum/sekúndu</entry>
</row>
<row valign="middle">
<entry align="left" morerows="1">ígleyptur skammtur</entry>
<entry align="left">gray (Gy)</entry>
<entry align="left" morerows="1">orka sem frásogast á hvert kg af vef</entry>
<entry align="left">1 Gy = 1 J/kg vefjar</entry>
</row>
<row valign="middle">
<entry align="left">ígleyptur geislaskammtur (rad)</entry>
<entry align="left">1 rad = 0,01 J/kg vefjar</entry>
</row>
<row valign="middle">
<entry align="left" morerows="1">líffræðilega virkur skammtur</entry>
