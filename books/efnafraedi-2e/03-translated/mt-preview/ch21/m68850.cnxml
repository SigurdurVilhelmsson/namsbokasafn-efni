  <md:title>Inngangur</md:title>
  <md:abstract><list id="list-00001"><item>Kjarnabygging og stöðugleiki</item><item>Kjarnajöfnur</item><item>Geislasundrun</item><item>Frumefnabreyting og kjarnorka</item><item>Notkun geislasamsætna</item><item>Líffræðileg áhrif geislunar</item></list></md:abstract>
  <md:uuid>242a0400-57dd-4b92-a971-19ed2c94b9c6</md:uuid>
