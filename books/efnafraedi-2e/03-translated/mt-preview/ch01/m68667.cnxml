<row>
<entry namest="c1" nameend="c6" align="center">Frumefnasamsetning jarðar</entry>
</row>
<row valign="top">
<entry align="left">Frumefni</entry>
<entry align="left">Tákn</entry>
<entry align="left">Massaprósenta</entry>
<entry align="left">Frumefni</entry>
