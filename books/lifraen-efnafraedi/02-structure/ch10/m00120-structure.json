        {
          "type": "figure",
          "id": "fig-00008",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00008-alt",
              "text": "The bromination reaction of alkene in the presence of N-bromosuccinimide, light, and carbon tetrachloride produces an allyl bromide through replacement of an allylic hydrogen."
            },
            "src": "../../media/OChem_10_EC_001.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00009",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00009-alt",
              "text": "The reaction of tertiary alcohol with HX in the presence of ether forms an alkyl halide. The reactivity of alcohols in decreasing order is tertiary, secondary, and primary."
            },
            "src": "../../media/OChem_10_EC_002.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00010",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00010-alt",
              "text": "The reaction of secondary alcohol with thionyl chloride in the presence of pyridine forms alkyl chloride where the OH in the reactant is replaced by Cl in the product."
            },
            "src": "../../media/OChem_10_EC_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00011",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00011-alt",
              "text": "The reaction of secondary alcohol with phosphorus tribromide in the presence of ether forms an alkyl bromide where the OH in the reactant is replaced by Br in the product."
            },
            "src": "../../media/OChem_10_EC_004.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00012",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00012-alt",
              "text": "The reaction of cyclohexanol with HF in the presence of pyridine forms fluorocyclohexane. Pyridine is shown as a six-membered aromatic ring containing five carbon atoms and one nitrogen."
            },
            "src": "../../media/OChem_10_EC_005.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00013",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00013-alt",
              "text": "The reaction of RX with magnesium in the presence of ether forms a Grignard reagent having formula R-Mg-X."
            },
            "src": "../../media/OChem_10_EC_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00014",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00014-alt",
              "text": "The reaction of RX with 2 equivalents of lithium in the presence of pentane forms R-Li and Li-X."
            },
            "src": "../../media/OChem_10_EC_007.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00015",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00015-alt",
              "text": "The reaction of 2 equivalents of R-Li with CuI in ether forms lithium di-R copper and Li I."
            },
            "src": "../../media/OChem_10_EC_008.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00016",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00016-alt",
              "text": "The reaction of di-R copper with R'-X in ether forms three products, R-R', R-Cu, and Li-X."
            },
            "src": "../../media/OChem_10_EC_009.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00017",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00120:alt:fig-00017-alt",
              "text": "The reaction between phenylboronic acid and iodobenzene in the presence of Pd (P Ph 3) 4, calcium carbonate, and tetrahydrofuran forms biphenyl."
            },
            "src": "../../media/OChem_10_EC_010.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
