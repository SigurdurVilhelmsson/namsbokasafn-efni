      "media": {
        "alt": {
          "segmentId": "m00120:alt:fig-00004-alt",
          "text": "Chemical structures of propene, isopropyl alcohol, acetone and propane."
        },
        "src": "../../media/OChem_10_08_004.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "figure",
      "id": "fig-00005",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00120:alt:fig-00005-alt",
          "text": "Four compounds arranged in order of increasing oxidation level: propane is lowest, isopropyl alcohol and propene are equal and intermediate, and acetone is highest. "
        },
        "src": "../../media/OChem_10_08_005.jpg",
        "mimeType": "image/jpeg"
      }
