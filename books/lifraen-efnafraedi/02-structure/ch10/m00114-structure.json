      "media": {
        "alt": {
          "segmentId": "m00114:alt:fig-00002-alt",
          "text": "The four steps of a chlorination reaction of methane in which each step replaces one more hydrogen with chlorine, finally forming C Cl 4."
        },
        "src": "../../media/OChem_10_02_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
