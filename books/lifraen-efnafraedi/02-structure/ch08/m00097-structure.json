      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00097:alt:fig-00004-alt",
          "text": "In the first reaction, cis-2-pentene reacts with chloroform in the presence of KOH to form a cis-dichlorocyclopropane. In the second reaction, cyclohexene reacts with chloroform in the presence of KOH."
        },
        "src": "../../media/OChem_08_09_004.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
