      "media": {
        "alt": {
          "segmentId": "m00090:alt:fig-00004-alt",
          "text": "A reaction mechanism shows an alkene reacts with molecular bromine to form a bromonium ion and a bromide ion."
        },
        "src": "../../media/OChem_08_02_004.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
