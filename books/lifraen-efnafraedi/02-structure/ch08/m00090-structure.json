      "media": {
        "alt": {
          "segmentId": "m00090:alt:fig-00005-alt",
          "text": "A reaction shows cyclopentene reacts with molecular bromine to form bromonium ion intermediate, which forms trans-1,2-dibromo-cyclopentane. The intermediate is also depicted by its electrostatic potential map."
        },
        "src": "../../media/OChem_08_02_005.jpg",
        "mimeType": "image/jpeg"
      }
    },
