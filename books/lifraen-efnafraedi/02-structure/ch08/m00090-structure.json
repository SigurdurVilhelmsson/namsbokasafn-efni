        "alt": {
          "segmentId": "m00090:alt:fig-00002-alt",
          "text": "A possible mechanism for the reaction of ethylene with molecular bromine to form a transition state and product, in which each carbon is bonded to a bromine atom."
        },
        "src": "../../media/OChem_08_02_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
