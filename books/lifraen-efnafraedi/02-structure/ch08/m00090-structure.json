        "alt": {
          "segmentId": "m00090:alt:fig-00003-alt",
          "text": "In a reaction, cyclopentene reacts with molecular bromine to form trans-1,2-dibromocyclopentane (sole product). Cis-1,2-dibromocyclopentane is not formed."
        },
        "src": "../../media/OChem_08_02_003.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00005",
