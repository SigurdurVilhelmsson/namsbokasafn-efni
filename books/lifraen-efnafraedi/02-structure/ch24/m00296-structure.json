    {
      "type": "section",
      "id": "sect-00005",
      "class": null,
      "title": {
        "segmentId": "m00296:title:sect-00005-title",
        "text": "Diazonium Coupling Reactions"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00022",
          "segmentId": "m00296:para:para-00022"
        },
        {
          "type": "figure",
          "id": "fig-00014",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00296:alt:fig-00014-alt",
              "text": "An arenediazonium salt reacts with benzene substituted with Y to form an azo compound. Y can be O H or N R 2 group."
            },
            "src": "../../media/OChem_24_08_015.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00023",
          "segmentId": "m00296:para:para-00023"
        },
        {
          "type": "figure",
          "id": "fig-00015",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00296:alt:fig-00015-alt",
              "text": "Benzenediazonium sulfate reacts with phenol to form an intermediate that reacts to form p-hydroxyazobenzene, orange crystals at 152 degree Celsius. The figure shows the electrostatic potential map of benzenediazonium sulfate."
            },
            "src": "../../media/OChem_24_08_016.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00024",
          "segmentId": "m00296:para:para-00024"
        },
        {
          "type": "figure",
          "id": "fig-00016",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00296:alt:fig-00016-alt",
              "text": "Benzenediazonium sulfate reacts with N,N-dimethylaniline to form p-(dimethylamino)azobenzene, yellow crystals with a melting point of 127 degree Celsius."
            },
            "src": "../../media/OChem_24_08_017.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
