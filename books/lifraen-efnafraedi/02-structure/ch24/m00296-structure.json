{
  "moduleId": "m00296",
  "title": {
    "segmentId": "m00296:title:auto-1",
    "text": "Reactions of Arylamines"
  },
  "documentClass": null,
  "metadata": {
    "uuid": "db32b340-beed-476f-bb6e-7a4450a4694b"
  },
  "content": [
    {
      "type": "section",
      "id": "sect-00001",
      "class": null,
      "title": {
        "segmentId": "m00296:title:sect-00001-title",
        "text": "Electrophilic Aromatic Substitutions"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00001",
          "segmentId": "m00296:para:para-00001"
        },
        {
          "type": "figure",
          "id": "fig-00001",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00296:alt:fig-00001-alt",
              "text": "Aniline reacts with three equivalents of bromine and water to form 2,4,6-tribromoaniline with 100 percent yield."
            },
            "src": "../../media/OChem_24_08_001.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00002",
          "segmentId": "m00296:para:para-00002"
        },
        {
          "type": "para",
          "id": "para-00003",
          "segmentId": "m00296:para:para-00003"
        },
        {
          "type": "figure",
          "id": "fig-00002",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00296:alt:fig-00002-alt",
              "text": "p-Toluidine reacts with acetic anhydride and pyridine to form N-(p-tolyl)acetamide. This reacts with bromine to form N-(2-bromo-4-methylphenyl)acetamide. This reacts with sodium hydroxide and water to form 2-bromo-4-methylaniline (79 percent yield)."
            },
            "src": "../../media/OChem_24_08_002.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00004",
          "segmentId": "m00296:para:para-00004"
        },
        {
          "type": "figure",
          "id": "fig-00003",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00296:alt:fig-00003-alt",
              "text": "Aniline reacts with acetic anhydride, pyridine to form N-phenylacetamide. This reacts with benzoyl chloride and aluminum chloride to form N-(4-benzoylphenyl)acetamide. This reacts with sodium hydroxide and water to form 4-aminobenzophenone."
            },
            "src": "../../media/OChem_24_08_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00005",
          "segmentId": "m00296:para:para-00005"
        },
        {
          "type": "para",
          "id": "para-00006",
          "segmentId": "m00296:para:para-00006"
        },
        {
          "type": "figure",
          "id": "fig-00004",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00296:alt:fig-00004-alt",
              "text": "Acetanilide reacts with sulfurochloridic acid to form 4-acetamidobenzene-1-sulfonyl chloride. This reacts with ammonia to form N-(4-sulfamoylphenyl)acetamide. This reacts with sodium hydroxide and water to form sulfanilamide."
            },
            "src": "../../media/OChem_24_08_004.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
    {
      "type": "section",
      "id": "sect-00002",
      "class": "section-exercises",
      "title": {
        "segmentId": "m00296:title:sect-00002-title",
