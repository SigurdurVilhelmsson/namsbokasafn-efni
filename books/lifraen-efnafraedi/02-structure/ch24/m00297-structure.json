    {
      "type": "section",
      "id": "sect-00001",
      "class": null,
      "title": {
        "segmentId": "m00297:title:sect-00001-title",
        "text": "Pyrrole and Imidazole"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00003",
          "segmentId": "m00297:para:para-00003"
        },
        {
          "type": "figure",
          "id": "fig-00002",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00002-alt",
              "text": "Furan reacts with ammonia, water, and aluminum oxide at 400 degree Celsius to form pyrrole. The atoms in the ring are numbered."
            },
            "src": "../../media/OChem_24_09_002.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00004",
          "segmentId": "m00297:para:para-00004"
        },
        {
          "type": "figure",
          "id": "fig-00003",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00003-alt",
              "text": "The structure, orbital view, and space-filling model of pyrrole. The structure has cyclopentadiene bonded with N H group. Nitrogen is s p 2 hybridized carrying a set of lone pairs."
            },
            "src": "../../media/OChem_24_09_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00005",
          "segmentId": "m00297:para:para-00005"
        },
        {
          "type": "figure",
          "id": "fig-00004",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00004-alt",
              "text": "The ball-and-stick model in electrostatic potential maps of pyrrole, pyrrolidine, and 1,3-cyclopentadiene. An arrow points toward the nitrogen atoms of pyrrole and pyrrolidine."
            },
            "src": "../../media/OChem_24_09_004.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00006",
          "segmentId": "m00297:para:para-00006"
        },
        {
          "type": "figure",
          "id": "fig-00005",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00005-alt",
              "text": "Pyrrole reacts with bromine at zero degree Celsius to form 2-bromopyrrole with 92 percent yield and hydrogen bromide."
            },
            "src": "../../media/OChem_24_09_005.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00007",
          "segmentId": "m00297:para:para-00007"
        },
        {
          "type": "figure",
          "id": "fig-00006",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00297:caption:fig-00006-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00006-alt",
              "text": "Electrophilic nitration of pyrrole. The attack of the nitro group at the second is more favored than the third position. The product 2-nitropyrrole is formed and 3-nitropyrrole is not formed."
            },
            "src": "../../media/OChem_24_09_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00008",
          "segmentId": "m00297:para:para-00008"
        },
        {
          "type": "figure",
          "id": "fig-00007",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00007-alt",
              "text": "The structures of imidazole, histidine, thiazole, and thiamin (vitamin B 1) with their respective p K a values. The atoms in imidazole and thiazole are numbered."
            },
            "src": "../../media/OChem_24_09_007.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
