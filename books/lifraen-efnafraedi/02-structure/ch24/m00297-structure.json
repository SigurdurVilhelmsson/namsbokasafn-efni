        },
        {
          "type": "figure",
          "id": "fig-00008",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00008-alt",
              "text": "Structure and orbital representations of pyridine and trimethylamine. The orbital containing the nonbonding pair on each nitrogen is labeled (s p 2 and s p 3 respectively)."
            },
            "src": "../../media/OChem_24_09_008.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00013",
          "segmentId": "m00297:para:para-00013"
        },
        {
          "type": "figure",
          "id": "fig-00009",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00009-alt",
              "text": "Pyridine reacts with bromine at 300 degree Celsius to form 3-bromopyridine with a 30 percent yield. The atoms in pyridine are numbered."
            },
            "src": "../../media/OChem_24_09_009.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00014",
          "segmentId": "m00297:para:para-00014"
        },
        {
          "type": "figure",
          "id": "fig-00010",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00010-alt",
              "text": "Structure of pyridine with a dipole arrow pointed from C 4 toward N. Value of dipole moment is 2.26 D."
            },
            "src": "../../media/OChem_24_09_010.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00015",
          "segmentId": "m00297:para:para-00015"
        },
        {
          "type": "figure",
          "id": "fig-00011",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00297:alt:fig-00011-alt",
              "text": "Structure of pyrimidine with atoms numbered. Value of p K a is 1.3."
            },
            "src": "../../media/OChem_24_09_011.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
