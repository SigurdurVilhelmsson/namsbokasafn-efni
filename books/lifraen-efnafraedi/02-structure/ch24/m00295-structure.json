          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00295:alt:fig-00003-alt",
              "text": "A quaternary ammonium salt reacts with hydroxide ion via an E 2 reaction to form an alkene, water and trimethylamine."
            },
            "src": "../../media/OChem_24_07_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
