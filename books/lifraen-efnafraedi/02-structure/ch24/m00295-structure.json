      },
      "content": [
        {
          "type": "para",
          "id": "para-00002",
          "segmentId": "m00295:para:para-00002"
        },
        {
          "type": "figure",
          "id": "fig-00002",
          "class": "unnumbered",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00295:alt:fig-00002-alt",
              "text": "1-Methylpentylamine reacts with excess methyl iodide to form (1-methylpentyl)trimethyl-ammonium iodide. This reacts with silver oxide and water to form 1-hexene with 60 percent yield and trimethylamine on heating."
            },
            "src": "../../media/OChem_24_07_002.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00003",
