{
  "moduleId": "m00294",
  "title": {
    "segmentId": "m00294:title:auto-1",
    "text": "Synthesis of Amines"
  },
  "documentClass": null,
  "metadata": {
    "uuid": "a613f412-c4a3-4cce-9ac6-930839fa508a"
  },
  "content": [
    {
      "type": "section",
      "id": "sect-00001",
      "class": null,
      "title": {
        "segmentId": "m00294:title:sect-00001-title",
        "text": "Reduction of Nitriles, Amides, and Nitro Compounds"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00001",
          "segmentId": "m00294:para:para-00001"
        },
        {
          "type": "figure",
          "id": "fig-00001",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00294:alt:fig-00001-alt",
              "text": "Alkyl halide reacts with sodium cyanide, then lithium aluminum hydride, then water. Carboxylic acid reacts with thionyl chloride, then ammonium, then lithium aluminum hydride, then water. Both form primary amine."
            },
            "src": "../../media/OChem_24_06_001.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00002",
          "segmentId": "m00294:para:para-00002"
        },
        {
          "type": "figure",
          "id": "fig-00002",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00294:alt:fig-00002-alt",
              "text": "p-tert-Butylnitrobenzene reacts with hydrogen, platinum catalyst, and ethanol to form p-tert-butylaniline (100%). Meta-nitrobenzaldehyde reacts with tin(2) chloride and hydronium ion, then sodium hydroxide to form m-aminobenzaldehyde (90%)."
            },
            "src": "../../media/OChem_24_06_002.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
    {
      "type": "section",
      "id": "sect-00002",
      "class": "section-exercises",
      "title": {
        "segmentId": "m00294:title:sect-00002-title",
