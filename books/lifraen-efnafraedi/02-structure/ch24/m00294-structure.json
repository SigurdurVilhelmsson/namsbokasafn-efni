    {
      "type": "section",
      "id": "sect-00007",
      "class": null,
      "title": {
        "segmentId": "m00294:title:sect-00007-title",
        "text": "Hofmann and Curtius Rearrangements"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00019",
          "segmentId": "m00294:para:para-00019"
        },
        {
          "type": "figure",
          "id": "fig-00013",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00294:alt:fig-00013-alt",
              "text": "Hofmann rearrangement: An amide reacts with sodium hydroxide, bromine, and water to form an amine. Curtius rearrangement: An acyl azide reacts with water and heat to form an amine."
            },
            "src": "../../media/OChem_24_06_016.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00020",
          "segmentId": "m00294:para:para-00020"
        },
        {
          "type": "figure",
          "id": "fig-00014",
          "class": "mechanism-figure scaled-down",
          "caption": {
            "segmentId": "m00294:caption:fig-00014-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00294:alt:fig-00014-alt",
              "text": "A six-step mechanism shows a Hoffman rearrangement, where an amide reacts with hydroxide ion, bromine, and water to form an amine."
            },
            "src": "../../media/OChem_24_06_017.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00021",
          "segmentId": "m00294:para:para-00021"
        },
        {
          "type": "figure",
          "id": "fig-00015",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00294:alt:fig-00015-alt",
              "text": "2,2-Dimethyl-3-phenylpropanamide reacts with sodium hydroxide, chlorine, and water to form phentermine (2-methyl-1-phenylpropan-2-amine) and carbon dioxide."
            },
            "src": "../../media/OChem_24_06_018.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00022",
          "segmentId": "m00294:para:para-00022"
        },
        {
          "type": "figure",
          "id": "fig-00016",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00294:alt:fig-00016-alt",
              "text": "Acid chloride reacts with sodium azide to form acyl azide which leads to isocyanate and nitrogen. This further reacts with water to form an amine and carbon dioxide."
            },
            "src": "../../media/OChem_24_06_019.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00023",
          "segmentId": "m00294:para:para-00023"
        },
        {
          "type": "figure",
          "id": "fig-00017",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00294:alt:fig-00017-alt",
              "text": "trans-2-Phenylcyclopropanecarbonyl chloride reacts with sodium azide, then heat, and finally with water to form tranylcypromine."
            },
            "src": "../../media/OChem_24_06_020.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "example",
          "id": "exam-00002",
          "title": {
            "segmentId": "m00294:example-title:exam-00002-title",
            "text": "Using the Hofmann and Curtius Rearrangements"
          },
          "content": [
            {
              "type": "para",
              "id": "para-00024",
              "segmentId": "m00294:para:para-00024"
            },
            {
              "type": "para",
              "id": "para-00025",
              "segmentId": "m00294:para:para-00025",
              "title": {
                "segmentId": "m00294:para-title:para-00025-title",
                "text": "Strategy"
              }
            },
            {
              "type": "para",
              "id": "para-00026",
              "title": {
                "segmentId": "m00294:para-title:para-00026-title",
                "text": "Solution"
              }
            }
          ]
        },
        {
          "type": "figure",
          "id": "fig-00018",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00294:alt:fig-00018-alt",
              "text": "o-Methylphenylacetic acid reacts with thionyl chloride to form an intermediate. This reacts with ammonia, then bromine, sodium hydroxide and water or sodium azide, then water and heat to form o-methylbenzylamine."
            },
            "src": "../../media/OChem_24_06_021.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
