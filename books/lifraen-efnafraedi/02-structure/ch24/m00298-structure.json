          "media": {
            "alt": {
              "segmentId": "m00298:alt:fig-00010-alt",
              "text": "2-Methyl indole reacts with alkyl halide in presence of potassium hydroxide and [bmim][P F 6] to form an intermediate. This reacts with acid chloride and [bmim][P F 6] forming pravadoline."
            },
            "src": "../../media/OChem_24_10_011.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
