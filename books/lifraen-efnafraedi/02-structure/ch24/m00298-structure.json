          "media": {
            "alt": {
              "segmentId": "m00298:alt:fig-00011-alt",
              "text": "Reversible reaction of 2-methylpropane with trans-2-butene to form 2,2,4-trimethyl pentene, 2,3,4-trimethylpentene, and 2,3,3-trimethylpeneten in 52, 20, and 18 percent yield, respectively."
            },
            "src": "../../media/OChem_24_10_012.jpg",
            "mimeType": "image/jpeg"
          }
        }
