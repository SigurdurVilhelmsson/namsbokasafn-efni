            "alt": {
              "segmentId": "m00298:alt:fig-00009-alt",
              "text": "The structures of hexafluorophosphate, tetrafluoroborate, methyl sulfate, trifluoromethane-sulfonate, and halide. The structure of hexafluorophosphate and tetrafluoroborate are enclosed in parentheses and have a negative charge on it."
            },
            "src": "../../media/OChem_24_10_010.jpg",
            "mimeType": "image/jpeg"
          }
        },
