  "content": [
    {
      "type": "section",
      "id": "sect-00001",
      "class": null,
      "title": {
        "segmentId": "m00298:title:sect-00001-title",
        "text": "Infrared Spectroscopy"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00001",
          "segmentId": "m00298:para:para-00001"
        },
        {
          "type": "figure",
          "id": "fig-00001",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00298:caption:fig-00001-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00298:alt:fig-00001-alt",
              "text": "The IR spectrum of cyclohexylamine, where peaks are observed at 900, 1500, 2900, and 3400 centimeter inverse. The peak around 3400 indicates the presence of an amine group."
            },
            "src": "../../media/OChem_24_10_001.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
    {
      "type": "section",
      "id": "sect-00002",
      "class": null,
      "title": {
        "segmentId": "m00298:title:sect-00002-title",
        "text": "Nuclear Magnetic Resonance Spectroscopy"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00002",
          "segmentId": "m00298:para:para-00002"
        },
        {
          "type": "figure",
          "id": "fig-00002",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00298:alt:fig-00002-alt",
              "text": "A reversible reaction in which N-methylmethanamine reacts with deuterium oxide to form a product in which hydrogen is replaced by deuterium. H D O is the second product."
            },
            "src": "../../media/OChem_24_10_002.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00003",
          "segmentId": "m00298:para:para-00003"
        },
        {
          "type": "figure",
          "id": "fig-00003",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00298:caption:fig-00003-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00298:alt:fig-00003-alt",
              "text": "H N M R spectrum with peaks at shift 0 (T M S), several small multiplets between 1 and 2, and a large singlet at around 2.4."
            },
            "src": "../../media/OChem_24_10_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00004",
          "segmentId": "m00298:para:para-00004"
        },
        {
          "type": "figure",
          "id": "fig-00004",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00298:alt:fig-00004-alt",
              "text": "The structure of cyclohexyl methyl amine. The chemical shift values of the carbon atoms are mentioned."
            },
            "src": "../../media/OChem_24_10_004.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
