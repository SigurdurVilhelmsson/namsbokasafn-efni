      "type": "section",
      "id": "sect-00004",
      "class": null,
      "title": {
        "segmentId": "m00298:title:sect-00004-title",
        "text": "Mass Spectrometry"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00006",
          "segmentId": "m00298:para:para-00006"
        },
        {
          "type": "para",
          "id": "para-00007",
          "segmentId": "m00298:para:para-00007"
        },
        {
          "type": "figure",
          "id": "fig-00005",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00298:alt:fig-00005-alt",
              "text": "Alkyl amines undergo alpha cleavage to form a radical and carbocation with two reversible resonance forms enclosed inside parentheses."
            },
            "src": "../../media/OChem_24_10_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00008",
          "segmentId": "m00298:para:para-00008"
        },
        {
          "type": "figure",
          "id": "fig-00006",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00298:caption:fig-00006-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00298:alt:fig-00006-alt",
              "text": "Mass spectrum of N-ethylpropylamine. M plus peak is at 87 and m by z peak is at 72 and 58. Alpha cleavage of the species leads to two fragment ions."
            },
            "src": "../../media/OChem_24_10_007.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
    {
