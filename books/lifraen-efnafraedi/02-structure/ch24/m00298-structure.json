          "media": {
            "alt": {
              "segmentId": "m00298:alt:fig-00007-alt",
              "text": "The structure shows two resonance forms of 1,3-dialkylimidazolium ions and one form of N-alkylpyridinium ions. The possible R groups in each structure are mentioned."
            },
            "src": "../../media/OChem_24_10_009.jpg",
            "mimeType": "image/jpeg"
