    {
      "type": "section",
      "id": "sect-00009",
      "class": null,
      "title": {
        "segmentId": "m00304:title:sect-00009-title",
        "text": "Chain Lengthening: The Kiliani–Fischer Synthesis"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00027",
          "segmentId": "m00304:para:para-00027"
        },
        {
          "type": "para",
          "id": "para-00028",
          "segmentId": "m00304:para:para-00028"
        },
        {
          "type": "para",
          "id": "para-00029",
          "segmentId": "m00304:para:para-00029"
        },
        {
          "type": "figure",
          "id": "fig-00014",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00304:alt:fig-00014-alt",
              "text": "Aldoses form cyanohydrins with hydrogen cyanide. Cyanohydrins are reduced with hydrogen and palladium catalyst to yield an imine intermediate that is hydrolyzed to form two chain lengthened aldoses."
            },
            "src": "../../media/OChem_25_06_015.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
