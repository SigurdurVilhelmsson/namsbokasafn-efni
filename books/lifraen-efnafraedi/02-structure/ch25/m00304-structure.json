    {
      "type": "section",
      "id": "sect-00011",
      "class": null,
      "title": {
        "segmentId": "m00304:title:sect-00011-title",
        "text": "Chain Shortening: The Wohl Degradation"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00032",
          "segmentId": "m00304:para:para-00032"
        },
        {
          "type": "para",
          "id": "para-00033",
          "segmentId": "m00304:para:para-00033"
        },
        {
          "type": "figure",
          "id": "fig-00015",
          "class": "unnumbered",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00304:alt:fig-00015-alt",
              "text": "Wohl degradation reaction. D-galactose reacts with hydroxylamine to form D-galactose oxime which reacts with acetic anhydride to give cyanohydrin. Cyanohydrin reacts with sodium methoxide to form D-lyxose (37 percent yield)."
            },
            "src": "../../media/OChem_25_06_016.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
