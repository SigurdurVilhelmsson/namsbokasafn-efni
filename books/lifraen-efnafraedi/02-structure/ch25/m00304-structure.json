    },
    {
      "type": "section",
      "id": "sect-00007",
      "class": null,
      "title": {
        "segmentId": "m00304:title:sect-00007-title",
        "text": "Oxidation of Monosaccharides"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00020",
          "segmentId": "m00304:para:para-00020"
        },
        {
          "type": "figure",
          "id": "fig-00010",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00304:alt:fig-00010-alt",
              "text": "The Haworth projection of D-glucose is converted to its Fischer projection. It reacts with bromine, water at pH 6 to form D-gluconic acid."
            },
            "src": "../../media/OChem_25_06_011.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00021",
          "segmentId": "m00304:para:para-00021"
        },
        {
          "type": "para",
          "id": "para-00022",
          "segmentId": "m00304:para:para-00022"
        },
        {
          "type": "figure",
          "id": "fig-00011",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00304:caption:fig-00011-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00304:alt:fig-00011-alt",
              "text": "The Fischer projection of converting D-fructose to a mixture of D-glucose and D-mannose using aqueous sodium hydroxide. An enediol intermediate is formed shown in parenthesis."
            },
            "src": "../../media/OChem_25_06_012.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00023",
          "segmentId": "m00304:para:para-00023"
        },
        {
          "type": "figure",
          "id": "fig-00012",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00304:alt:fig-00012-alt",
              "text": "The Haworth projection of D-glucose is converted to its Fischer projection. It reacts with H N O 3 and water to form D-glucaric acid."
            },
            "src": "../../media/OChem_25_06_013.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00024",
          "segmentId": "m00304:para:para-00024"
        },
        {
          "type": "figure",
          "id": "fig-00013",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00304:alt:fig-00013-alt",
              "text": "The Haworth projection of D-glucose is oxidized through an enzymatic reaction to yield D-glucuronic acid, a uronic acid "
            },
            "src": "../../media/OChem_25_06_014.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
