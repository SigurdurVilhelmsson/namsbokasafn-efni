      },
      "media": {
        "alt": {
          "segmentId": "m00303:alt:fig-00003-alt",
          "text": "The Fischer and Haworth projection of beta-D-fructopyranose and beta-D-fructofuranose. Formation of pyranose and furanose anomers form through the hydroxyl group addition to C 2 carbonyl."
        },
        "src": "../../media/OChem_25_05_003.jpg",
        "mimeType": "image/jpeg"
      }
