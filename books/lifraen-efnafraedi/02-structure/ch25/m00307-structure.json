    {
      "type": "section",
      "id": "sect-00003",
      "class": null,
      "title": {
        "segmentId": "m00307:title:sect-00003-title",
        "text": "Polysaccharide Synthesis"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00008",
          "segmentId": "m00307:para:para-00008"
        },
        {
          "type": "para",
          "id": "para-00009",
          "segmentId": "m00307:para:para-00009"
        },
        {
          "type": "figure",
          "id": "fig-00005",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00307:alt:fig-00005-alt",
              "text": "Primary alcohol of glycal is protected by forming silyl ether. Two adjacent secondary alcohols are protected by forming cyclic carbonate ester. Double bond of protected glycal is converted into epoxide."
            },
            "src": "../../media/OChem_25_09_005.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00010",
          "segmentId": "m00307:para:para-00010"
        },
        {
          "type": "figure",
          "id": "fig-00006",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00307:alt:fig-00006-alt",
              "text": "Glycal epoxide when reacts with a second glycal having a free hydroxyl group with zinc chloride as a catalyst yields a disaccharide glycal."
            },
            "src": "../../media/OChem_25_09_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00011",
          "segmentId": "m00307:para:para-00011"
        },
        {
          "type": "figure",
          "id": "fig-00007",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00307:alt:fig-00007-alt",
              "text": "The Haworth projection of Lewis Y hexasaccharide is depicted. Alpha-Fucose bonded to beta-galactose bonded to beta-N-acetylglucosamine in turn bonded to alpha-fucose is shown."
            },
            "src": "../../media/OChem_25_09_007.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    }
