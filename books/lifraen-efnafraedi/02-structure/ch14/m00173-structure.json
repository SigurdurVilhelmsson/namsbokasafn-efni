      "media": {
        "alt": {
          "segmentId": "m00173:alt:fig-00004-alt",
          "text": "Reactant A forms products B and C in faster and slower reactions, respectively. The text next to the reaction generating product B reads Kinetic control (Lower temperature; irreversible)."
        },
        "src": "../../media/OChem_14_03_004.jpg",
        "mimeType": "image/jpeg"
