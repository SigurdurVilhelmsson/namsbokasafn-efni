        "alt": {
          "segmentId": "m00173:alt:fig-00003-alt",
          "text": "The energy diagram shows the thermodynamic control curve forming a higher peak than the kinetic control curve. The x and y axes denotes reaction progress and energy, respectively."
        },
        "src": "../../media/OChem_14_03_003.jpg",
        "mimeType": "image/jpeg"
      }
    },
