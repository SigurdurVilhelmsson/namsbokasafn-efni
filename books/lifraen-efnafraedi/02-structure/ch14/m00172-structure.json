      "media": {
        "alt": {
          "segmentId": "m00172:alt:fig-00006-alt",
          "text": "The reaction of 2-methyl-1,3-cyclohexadiene with hydrogen chloride gives three different products, 3-chloro-3-methylcyclohexene, 3-chloro-1-methylcyclohexene, and 6-chloro-1-methylcyclohexene via 1-2, 1-4, and 1-2 and 1-4 additions, respectively."
        },
