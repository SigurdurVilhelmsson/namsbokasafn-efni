    },
    {
      "type": "figure",
      "id": "fig-00002",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00179:alt:fig-00002-alt",
          "text": "Beta-carotene converts to vitamin A, which further converts to 11-cis-retinal. The carbon atoms in 11-cis-retinal are numbered from left to right."
        },
        "src": "../../media/OChem_14_09_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00005",
      "segmentId": "m00179:para:para-00005"
    },
    {
      "type": "figure",
      "id": "fig-00003",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00179:alt:fig-00003-alt",
          "text": "In a reaction, Rhodopsin in the presence of light forms Metarhodopsin 2. The cis and trans C C double bond at positions 5 and 6 in reactant and product are labeled, respectively."
        },
        "src": "../../media/OChem_14_09_003.jpg",
        "mimeType": "image/jpeg"
      }
    },
