          "media": {
            "alt": {
              "segmentId": "m00179:alt:fig-00006-alt",
              "text": "In water, diazonaphthoquinone and Novolac resin react in the presence of light to form form benzene fused to cyclopentene with C 1 bonded to carboxylic acid. Molecular nitrogen is the byproduct."
            },
            "src": "../../media/OChem_14_09_006.jpg",
            "mimeType": "image/jpeg"
          }
