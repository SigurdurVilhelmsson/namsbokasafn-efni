          "media": {
            "alt": {
              "segmentId": "m00237:alt:fig-00004-alt",
              "text": "The proton spectrum of phenylacetic acid shows peaks at 0 (T M S), 3.7 (singlet), 7.3 (multiplet), and 12.0 (singlet)."
            },
