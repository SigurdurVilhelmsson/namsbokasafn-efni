        {
          "type": "figure",
          "id": "fig-00008",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00237:alt:fig-00008-alt",
              "text": "Organomagnesium halide reacts with carbon dioxide followed by acid hydrolysis to produce a carboxylic acid. Carbon dioxide's carbon becomes the carboxyl."
            },
            "src": "../../media/OChem_20_EC_001.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00009",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00237:alt:fig-00009-alt",
              "text": "Nitrile reacts with hydronium or sodium hydroxide and water to produce carboxylic acid. Nitrile carbon becomes the carboxyl."
            },
            "src": "../../media/OChem_20_EC_002.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00010",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00237:alt:fig-00010-alt",
              "text": "Alkyl bromide reacts with sodium cyanide to produce a nitrile. Cyanide carbon becomes nitrile carbon."
            },
            "src": "../../media/OChem_20_EC_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00011",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00237:alt:fig-00011-alt",
              "text": "An amide reacts with thionyl chloride to form nitrile, sulfur dioxide, and two equivalents of hydrogen chloride. Carbonyl carbon becomes nitrile carbon."
            },
            "src": "../../media/OChem_20_EC_004.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00012",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00237:alt:fig-00012-alt",
              "text": "Nitrile reacts first with sodium hydroxide and water, then with hydronium to produce carboxylic acid and ammonia. Nitrile nitrogen becomes ammonia nitrogen."
            },
            "src": "../../media/OChem_20_EC_005.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00013",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00237:alt:fig-00013-alt",
              "text": "Nitrile reacts first with lithium aluminum hydride, then with water to produce a primary amine. Nitrile nitrogen becomes amine nitrogen."
            },
            "src": "../../media/OChem_20_EC_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00014",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00237:alt:fig-00014-alt",
              "text": "Nitrile reacts first with organomagnesium bromide in ether, then with hydronium to produce a ketone and ammonia."
            },
            "src": "../../media/OChem_20_EC_007.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
