      "id": "sect-00003",
      "class": null,
      "title": {
        "segmentId": "m00252:title:sect-00003-title",
        "text": "Base-Catalyzed Epoxide Opening"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00011",
          "segmentId": "m00252:para:para-00011"
        },
        {
          "type": "figure",
          "id": "fig-00007",
          "class": "unnumbered",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00252:alt:fig-00007-alt",
              "text": "Methylenecyclohexane oxide reacts with hydroxyl ion to form an intermediate that yields 1-hydroxymethylcyclohexanol (70 percent yield) and hydroxide."
            },
            "src": "../../media/OChem_18_06_009.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00012",
          "segmentId": "m00252:para:para-00012"
        },
        {
          "type": "figure",
          "id": "fig-00008",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00252:alt:fig-00008-alt",
              "text": "1,2-epoxypropane reacts with ethanol and ethoxide ion to form 1-ethoxy-2-propanol (83 percent yield). Ethoxide attacks the less substituted side; no attack on secondary carbon."
            },
            "src": "../../media/OChem_18_06_010.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00013",
          "segmentId": "m00252:para:para-00013"
        },
        {
          "type": "figure",
          "id": "fig-00009",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00252:alt:fig-00009-alt",
              "text": "An epoxide reacts with alcohol to form an intermediate, which, in the presence of amine yields metoprolol. The reaction mechanism is depicted using arrows."
            },
            "src": "../../media/OChem_18_06_011.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00014",
          "segmentId": "m00252:para:para-00014"
        },
        {
          "type": "figure",
          "id": "fig-00010",
          "class": "unnumbered",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00252:alt:fig-00010-alt",
              "text": "Butylmagnesium bromide reacts with ethylene oxide in ether, then with hydronium ion to form 1-hexanol with 62 percent yield."
            },
            "src": "../../media/OChem_18_06_012.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
