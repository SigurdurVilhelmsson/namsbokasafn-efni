      "media": {
        "alt": {
          "segmentId": "m00250:alt:fig-00003-alt",
          "text": "Tert-butyl cyclohexyl ether reacts with trifluoroacetic acid at zero degrees Celcius forming cyclohexanol (90 percent yield) and 2-methylpropene."
        },
        "src": "../../media/OChem_18_03_003.jpg",
        "mimeType": "image/jpeg"
      }
