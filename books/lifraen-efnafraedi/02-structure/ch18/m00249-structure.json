        {
          "type": "figure",
          "id": "fig-00006",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00249:alt:fig-00006-alt",
              "text": "The structure of ethyl phenyl ether where C H 2 is labeled primary carbon, compatible with Williamson method, and ethyl group is labeled alkene-derived, compatible with alkoxymercuration method."
            },
            "src": "../../media/OChem_18_02_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00007",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00249:alt:fig-00007-alt",
              "text": "Phenol undergoes two reactions with different reagents. First with sodium hydroxide, then ethyl bromide; second with mercuric trifluoroacetate, then sodium borohydride. Both pathways form the same product ethyl phenyl ether."
            },
            "src": "../../media/OChem_18_02_007.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
