      "media": {
        "alt": {
          "segmentId": "m00020:alt:fig-00001-alt",
          "text": "Chemical structure and ball-and-stick model in electron potental map of dimethylsulfoxide. Central S has two methyl groups, oxygen, and a nonbonding pair. Sulfur is formal positive, oxygen is formal negative."
        },
        "src": "../../media/OChem_02_03_001.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
