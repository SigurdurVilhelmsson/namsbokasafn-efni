                "text": "Strategy"
              }
            },
            {
              "type": "para",
              "id": "para-00020",
              "title": {
                "segmentId": "m00269:para-title:para-00020-title",
                "text": "Solution"
              }
            }
          ]
        },
        {
          "type": "figure",
          "id": "fig-00013",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00269:alt:fig-00013-alt",
              "text": "The structure of alpha-terpineol in which cyclohexene has methyl on C 1, and a C H linked to two methyl groups and an alcohol on C 4 position."
            },
            "src": "../../media/OChem_27_05_014.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00014",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00269:alt:fig-00014-alt",
              "text": "Linalyl diphosphate forms a carbocation intermediate with the release of inorganic pyrophosphate. The attack of water on carbocation leads to alpha-terpineol."
            },
            "src": "../../media/OChem_27_05_015.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
    {
