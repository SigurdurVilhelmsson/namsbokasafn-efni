        }
      ]
    },
    {
      "type": "section",
      "id": "sect-00007",
      "class": null,
      "title": {
        "segmentId": "m00269:title:sect-00007-title",
        "text": "Conversion of Isopentenyl Diphosphate to Terpenoids"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00012",
          "segmentId": "m00269:para:para-00012"
        },
        {
          "type": "para",
          "id": "para-00013",
          "segmentId": "m00269:para:para-00013"
        },
        {
          "type": "figure",
          "id": "fig-00009",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00269:caption:fig-00009-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00269:alt:fig-00009-alt",
              "text": "Isopentenyl diphosphate isomerizes to dimethylallyl diphosphate which forms geranyl diphosphate. Geranyl diphosphate generates monoterpenes or farnesyl diphosphate. Farnesyl diphosphate undergoes dimerization to form squalene or triterpenes."
            },
            "src": "../../media/OChem_27_05_010.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00014",
          "segmentId": "m00269:para:para-00014"
        },
        {
          "type": "figure",
          "id": "fig-00010",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00269:alt:fig-00010-alt",
              "text": "Protonation of isopentenyl diphosphate leads to a carbocation that rearranges to dimethylallyl diphosphate."
            },
            "src": "../../media/OChem_27_05_011.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00015",
          "segmentId": "m00269:para:para-00015"
        },
        {
          "type": "figure",
          "id": "fig-00011",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00269:caption:fig-00011-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00269:alt:fig-00011-alt",
              "text": "Dimethylallyl diphosphate forms an allylic carbocation that reacts with isopentenyl pyrophosphate to form geranyl diphosphate. This further reacts to form farnesyl diphosphate."
            },
            "src": "../../media/OChem_27_05_012.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00016",
          "segmentId": "m00269:para:para-00016"
        },
        {
          "type": "para",
          "id": "para-00017",
          "segmentId": "m00269:para:para-00017"
        },
        {
          "type": "figure",
          "id": "fig-00012",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00269:caption:fig-00012-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00269:alt:fig-00012-alt",
              "text": "Geranyl diphosphate via an allylic carbocation forms linalyl diphosphate, which further rearranges through an allylic carbocation cyclization to form limonene."
            },
            "src": "../../media/OChem_27_05_013.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "example",
          "id": "exam-00001",
          "title": {
            "segmentId": "m00269:example-title:exam-00001-title",
            "text": "Proposing a Terpenoid Biosynthesis Pathway"
          },
          "content": [
            {
