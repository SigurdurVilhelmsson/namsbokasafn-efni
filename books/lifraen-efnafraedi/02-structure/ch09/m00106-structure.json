    {
      "type": "section",
      "id": "sect-00001",
      "class": null,
      "title": {
        "segmentId": "m00106:title:sect-00001-title",
        "text": "Mercury(II)-Catalyzed Hydration of Alkynes"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00002",
          "segmentId": "m00106:para:para-00002"
        },
        {
          "type": "figure",
          "id": "fig-00001",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00106:alt:fig-00001-alt",
              "text": "The figure shows 1-hexyne reacting with water, sulfuric acid, and mercury sulfate to generate an enol. This further leads to the final product, 2-hexanone (78%)."
            },
            "src": "../../media/OChem_09_04_001.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00003",
          "segmentId": "m00106:para:para-00003"
        },
        {
          "type": "figure",
          "id": "fig-00002",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00106:alt:fig-00002-alt",
              "text": "Two reversible structures separated by a double headed arrow. The first structure is a less favored enol tautomer. The second structure is a more favored keto tautomer."
            },
            "src": "../../media/OChem_09_04_002.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00004",
          "segmentId": "m00106:para:para-00004"
        },
        {
          "type": "figure",
          "id": "fig-00003",
          "class": "mechanism-figure scaled-down",
          "caption": {
            "segmentId": "m00106:caption:fig-00003-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00106:alt:fig-00003-alt",
              "text": "Figure shows a five-step mechanism for the generation of a ketone from an alkyne. The alkyne reacts with a mercury (II) ion followed by hydrolysis to generate a ketone."
            },
            "src": "../../media/OChem_09_04_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00005",
          "segmentId": "m00106:para:para-00005"
        },
        {
          "type": "figure",
          "id": "fig-00004",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00106:alt:fig-00004-alt",
              "text": "Two reactions, one which involves an internal alkyne producing a mixture of ketones.The second reaction involves a terminal alkyne producing methyl ketone.The reagent used is hydronium cation and mercury sulfate."
            },
            "src": "../../media/OChem_09_04_004.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
