            },
            "src": "../../media/OChem_09_EC_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00024",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00111:alt:fig-00024-alt",
