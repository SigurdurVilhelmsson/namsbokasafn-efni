      "media": {
        "alt": {
          "segmentId": "m00276:alt:fig-00001-alt",
          "text": "The three-step reaction is involved in the formation of beta-hydroxy carbonyl compound on the reaction of a carbonyl compound with base."
        },
        "src": "../../media/OChem_23_01_001.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00002",
