    },
    {
      "type": "figure",
      "id": "fig-00002",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00276:alt:fig-00002-alt",
          "text": "Acetaldehyde reacts with sodium hydroxide and ethanol to yield an enolate ion, which further reacts with ethanal and forms 3-hydroxybutanal (aldol compound) with the release of hydroxide ion."
        },
        "src": "../../media/OChem_23_01_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00003",
      "segmentId": "m00276:para:para-00003"
    },
    {
      "type": "figure",
      "id": "fig-00004",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00276:alt:fig-00004-alt",
          "text": "2 equivalents of phenylacetaldehyde react reversibly in sodium hydroxide and ethanol to produce beta-hydroxyaldehyde (90%); 2 equivalents of cyclohexanone react reversibly in sodium hydroxide and ethanol to produce beta-hydroxyketone (22%)."
        },
        "src": "../../media/OSX_OrgChem_23_01_OChem-23-01-003_80485-23-u003a_AldeKet_img.jpg",
        "mimeType": "image/jpeg"
      }
