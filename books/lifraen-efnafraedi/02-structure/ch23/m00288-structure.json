          "caption": {
            "segmentId": "m00288:caption:fig-00004-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00288:alt:fig-00004-alt",
              "text": "A photo shows a portrait human face made using different dried and fresh, flowers and leaves."
            },
            "src": "../../media/OSX_OrgChem_23_98_Flowers.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00007",
          "segmentId": "m00288:para:para-00007"
        },
        {
          "type": "figure",
          "id": "fig-00005",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00288:alt:fig-00005-alt",
              "text": "The reaction shows the glycolysis of glucose into two pyruvate molecules. Glucose is in a chair conformation with carbon atoms highlighted using pink, blue, and green colors."
            },
            "src": "../../media/OChem_23_13_005.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00008",
          "segmentId": "m00288:para:para-00008"
        },
        {
          "type": "figure",
          "id": "fig-00006",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00288:alt:fig-00006-alt",
              "text": "The reversible reaction shows the conversion of glucose into fructose through the formation of aldehyde and enol forms of glucose. The initial glucose is in hemiacetal form."
            },
            "src": "../../media/OChem_23_13_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00009",
          "segmentId": "m00288:para:para-00009"
        },
        {
          "type": "figure",
          "id": "fig-00007",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00288:alt:fig-00007-alt",
              "text": "The reaction shows the conversion of fructose (six-carbon chain) in the presence of a base to form a ketone and aldehyde, both containing a vertical three-carbon chain."
            },
            "src": "../../media/OChem_23_13_007.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00010",
          "segmentId": "m00288:para:para-00010"
