                "align": "left"
              },
              "alt": {
                "segmentId": "m00285:alt:OChem_23_10_004i_jpg-alt",
                "text": "The structure of diethyl malonate, a Michael donor. Carbonyl with ethoxy substituent is bonded to C H 2, which is bonded to another carbonyl with ethoxy substituent.",
                "mediaId": null,
                "src": "../../media/OChem_23_10_004i.jpg"
              }
            },
            {
              "segmentId": "m00285:entry:auto-25",
              "attributes": {
