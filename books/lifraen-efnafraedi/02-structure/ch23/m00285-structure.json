            {
              "segmentId": null,
              "attributes": {
                "valign": "top",
                "align": "left"
              },
              "alt": {
                "segmentId": "m00285:alt:OChem_23_10_004c_jpg-alt",
                "text": "The structure of ethyl propenoate (Michael acceptor) shows a three-carbon chain where the second and third carbon share double bond. An ethoxy group is attached to the first carbonyl carbon.",
                "mediaId": null,
                "src": "../../media/OChem_23_10_004c.jpg"
              }
            },
            {
              "segmentId": "m00285:entry:auto-23",
              "attributes": {
                "valign": "top",
