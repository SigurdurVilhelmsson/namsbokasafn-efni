              "alt": {
                "segmentId": "m00285:alt:OChem_23_10_004d_jpg-alt",
                "text": "The structure of propenamide (Michael acceptor) shows a three-carbon chain with N H 2 group attached to the carbonyl carbon. The second and third carbon atoms are double-bonded.",
                "mediaId": null,
                "src": "../../media/OChem_23_10_004d.jpg"
              }
            },
            {
              "segmentId": "m00285:entry:auto-27",
              "attributes": {
                "valign": "top",
                "align": "left"
