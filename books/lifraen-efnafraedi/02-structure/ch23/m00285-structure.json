                "align": "left"
              },
              "alt": {
                "segmentId": "m00285:alt:OChem_23_10_004a_jpg-alt",
                "text": "The structure of the propenal shows a three-carbon chain. A double bond is shared between the second and third carbon. The first carbon is part of C H O group.",
                "mediaId": null,
                "src": "../../media/OChem_23_10_004a.jpg"
              }
            },
            {
              "segmentId": "m00285:entry:auto-15",
              "attributes": {
