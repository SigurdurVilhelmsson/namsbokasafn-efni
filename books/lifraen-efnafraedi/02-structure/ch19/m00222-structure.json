      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00222:alt:fig-00002-alt",
          "text": "A cyclic reversible reaction where aldehyde or ketone reacts with ylide, to form betaine (intermediate), which further forms oxaphosphetane. This transforms back to the reactants, aldehyde or ketone and ylide."
        },
        "src": "../../media/OChem_19_11_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
