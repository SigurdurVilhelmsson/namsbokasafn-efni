      "media": {
        "alt": {
          "segmentId": "m00222:alt:fig-00003-alt",
          "text": "Triphenylphosphine reacts with bromomethane via an S N 2 reaction to produce methyltriphenylphosphonium bromide, which then reacts with B u L i and T H F to form methylenetriphenylphosphorane."
        },
        "src": "../../media/OChem_19_11_003.jpg",
        "mimeType": "image/jpeg"
