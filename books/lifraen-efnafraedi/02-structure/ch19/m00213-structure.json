          "media": {
            "alt": {
              "segmentId": "m00213:alt:fig-00005-alt",
              "text": "A benzene reacts with acetyl chloride in the presence of aluminum chloride and heat to produce acetophenone (95 percent yield)."
            },
            "src": "../../media/OChem_19_02_005.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
