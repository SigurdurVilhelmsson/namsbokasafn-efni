      "media": {
        "alt": {
          "segmentId": "m00216:alt:fig-00002-alt",
          "text": "A reversible reaction in which formaldehyde (0.1 percent) reacts with water forming formaldehyde hydrate (99.9 percent). It has a tetrahedral structure in which carbon is single-bonded to two hydroxyl groups."
        },
        "src": "../../media/OChem_19_05_002.jpg",
        "mimeType": "image/jpeg"
      }
