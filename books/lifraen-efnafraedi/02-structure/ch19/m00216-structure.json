      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00216:alt:fig-00003-alt",
          "text": "Two reversible reactions. Pyruvic acid (40 percent) reacts with water to give pyruvic acid hydrate (60 percent). Alpha-ketoglutaric (50 percent) reacts with water to give alpha-ketoglutaric acid hydrate (50 percent)."
        },
        "src": "../../media/OChem_19_05_Pyruvic.jpg",
