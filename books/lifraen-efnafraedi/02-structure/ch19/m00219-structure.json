      "media": {
        "alt": {
          "segmentId": "m00219:alt:fig-00001-alt",
          "text": "Two reversible pathways from ketone or aldehyde. Conversion of aldehyde or ketone to imine and water using R N H 2 and enamine and water using R 2 N H."
        },
