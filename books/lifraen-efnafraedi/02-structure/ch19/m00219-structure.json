    },
    {
      "type": "figure",
      "id": "fig-00002",
      "class": "unnumbered",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00219:alt:fig-00002-alt",
          "text": "Reaction of pyridoxal phosphate and alanine in multiple steps to form the Schiff base, an imine, and water. Schiff base has a imine functional group."
        },
        "src": "../../media/OChem_19_08_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
