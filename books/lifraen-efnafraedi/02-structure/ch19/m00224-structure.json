        }
      ]
    },
    {
      "type": "section",
      "id": "sect-00004",
      "class": null,
      "title": {
        "segmentId": "m00224:title:sect-00004-title",
        "text": "Conjugate Addition of Alkyl Groups: Organocopper Reactions"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00007",
          "segmentId": "m00224:para:para-00007"
        },
        {
          "type": "figure",
          "id": "fig-00006",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00224:alt:fig-00006-alt",
              "text": "An alpha beta-unsaturated ketone reacts first with R anion, then with hydronium, to produce a saturated product with R as a substituent on the beta carbon."
            },
            "src": "../../media/OChem_19_13_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00008",
          "segmentId": "m00224:para:para-00008"
        },
        {
          "type": "figure",
          "id": "fig-00007",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00224:alt:fig-00007-alt",
              "text": "R X reacts with two equivalents lithium in pentane to form R L i Two equivalents of this react with copper iodide in ether to form lithium diorganocopper (Gilman reagent)."
            },
            "src": "../../media/OChem_19_13_007.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00009",
          "segmentId": "m00224:para:para-00009"
        },
        {
          "type": "figure",
          "id": "fig-00008",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00224:alt:fig-00008-alt",
              "text": "2-cyclohexenone reacts with methyl magnesium bromide or methyl lithium, then hydronium, to yield 1-methyl-2-cyclohexen-1-ol, or with Gilman reagent, then hydronium, to yield 3-methylcyclohexanone."
            },
            "src": "../../media/OChem_19_13_008.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00010",
          "segmentId": "m00224:para:para-00010"
        },
        {
          "type": "figure",
          "id": "fig-00009",
          "class": "unnumbered",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00224:alt:fig-00009-alt",
              "text": "Alpha-beta unsaturated ketone reacts with lithium bonded R 2 C u compound to form copper-containing intermediate. This reacts with hydronium ion to form saturated carbonyl with R at beta carbon."
            },
            "src": "../../media/OChem_19_13_009.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "example",
          "id": "exam-00001",
          "title": {
            "segmentId": "m00224:example-title:exam-00001-title",
            "text": "Using a Conjugate Addition Reaction"
          },
          "content": [
            {
              "type": "para",
              "id": "para-00011",
              "segmentId": "m00224:para:para-00011"
            },
            {
