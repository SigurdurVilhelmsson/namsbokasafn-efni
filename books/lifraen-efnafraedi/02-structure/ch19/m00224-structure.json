              "id": "para-00012",
              "segmentId": "m00224:para:para-00012",
              "title": {
                "segmentId": "m00224:para-title:para-00012-title",
                "text": "Strategy"
              }
            },
            {
              "type": "para",
              "id": "para-00013",
              "title": {
                "segmentId": "m00224:para-title:para-00013-title",
                "text": "Solution"
              }
            }
          ]
        },
        {
          "type": "figure",
          "id": "fig-00010",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00224:alt:fig-00010-alt",
              "text": "The structure of 2-methyl-3-propylcyclopentane. It is cyclopentanone with methyl on C 2 and propyl on C 3 position."
            },
            "src": "../../media/OChem_19_13_010.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00011",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00224:alt:fig-00011-alt",
              "text": "2-methyl-2-cyclopentenone reacts with lithium dipropylcopper in ether, then hydronium ion to form 2-methyl-3-propylcylopentanone."
            },
            "src": "../../media/OChem_19_13_011.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
