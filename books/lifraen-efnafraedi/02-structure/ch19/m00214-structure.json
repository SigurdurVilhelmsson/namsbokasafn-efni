  "title": {
    "segmentId": "m00214:title:auto-1",
    "text": "Oxidation of Aldehydes and Ketones"
  },
  "documentClass": null,
  "metadata": {
    "uuid": "54656997-8a85-4e87-8187-fc15c3b7ac95"
  },
  "content": [
    {
      "type": "para",
      "id": "para-00001",
      "segmentId": "m00214:para:para-00001"
    },
    {
      "type": "figure",
      "id": "fig-00001",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00214:alt:fig-00001-alt",
          "text": "An aldehyde reacts with nascent oxygen to form a carboxylic acid, while a ketone reacts with nascent oxygen giving no reaction since hydrogen is not attached to the carbonyl group."
        },
        "src": "../../media/OChem_19_03_001.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00002",
      "segmentId": "m00214:para:para-00002"
    },
    {
      "type": "figure",
      "id": "fig-00002",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00214:alt:fig-00002-alt",
          "text": "Hexanal reacts with chromium trioxide, hydronium ion, and acetone at zero degree Celsius to produce hexanoic acid (85 percent). Hydrogen in aldehyde group gets replaced by hydroxyl in the product."
        },
        "src": "../../media/OChem_19_03_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00003",
      "segmentId": "m00214:para:para-00003"
    },
    {
      "type": "figure",
      "id": "fig-00003",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00214:alt:fig-00003-alt",
          "text": "Aldehyde undergoes a reversible reaction with water to form a hydrate intermediate, which then reacts with chromium trioxide and hydronium ion to produce a carboxylic acid."
        },
        "src": "../../media/OChem_19_03_003.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00004",
      "segmentId": "m00214:para:para-00004"
    },
    {
      "type": "figure",
      "id": "fig-00004",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00214:alt:fig-00004-alt",
          "text": "Cyclohexanone reacts first with potassium permanganate, water, sodium hydroxide, then with hydronium to form hexanedioic acid (79 percent), a six-carbon chain with carboxylic acid groups at the terminal positions."
        },
        "src": "../../media/OChem_19_03_004.jpg",
        "mimeType": "image/jpeg"
      }
    }
  ],
  "sectionOrder": 3
}