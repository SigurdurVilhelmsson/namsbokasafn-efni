          "media": {
            "alt": {
              "segmentId": "m00187:alt:fig-00008-alt",
              "text": "A baseball player pitching a ball."
            },
            "src": "../../media/OChem_15_98_Athlete.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00009",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00187:alt:fig-00009-alt",
              "text": "Salicyl alcohol can be converted to salicylic acid, which can be further transformed to acetylsalicylic acid (aspirin)."
            },
            "src": "../../media/OChem_15_07_011.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
