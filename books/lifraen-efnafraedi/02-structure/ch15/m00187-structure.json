          "type": "figure",
          "id": "fig-00001",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00187:caption:fig-00001-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00187:alt:fig-00001-alt",
              "text": "The infrared spectrum of toluene shows peaks as follows: Monosubstituted ring C single bond H stretches at 690 and 710 wavenumbers, ring bonds at 1500 and 1600 wavenumbers and C single bond H stretches of methyl group at 3000 wavenumbers."
            },
            "src": "../../media/OChem_15_07_001.jpg",
            "mimeType": "image/jpeg"
          }
        }
