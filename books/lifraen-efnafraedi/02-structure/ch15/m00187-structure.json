          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00187:alt:fig-00010-alt",
              "text": "The structures of ibuprofen (Advil, Nuprin, Motrin are its brand names) and naproxen (Aleve, Naprosyn are its brand names)."
            },
            "src": "../../media/OChem_15_07_012.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00016",
