        },
        {
          "type": "figure",
          "id": "fig-00011",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00187:alt:fig-00011-alt",
              "text": "Rofecoxib (Vioxx) has a 5-membered ring made of an oxygen and four carbons with a double bond betwween C 2 and C 3 and C1 is a carbonyl group. Each of the carbons of the double bond is attached to a benzene ring, one of which is further substituted."
            },
            "src": "../../media/OChem_15_07_013.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
