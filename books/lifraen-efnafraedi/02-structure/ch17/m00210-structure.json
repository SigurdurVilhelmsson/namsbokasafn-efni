        {
          "type": "figure",
          "id": "fig-00001",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00210:caption:fig-00001-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00210:alt:fig-00001-alt",
              "text": "I R spectrum of cyclohexanol. Sharp peak just below 1100 is labeled C O stretch, broad peak around 3400 labeled O H stretch. Other significant peaks just below 3000 wavenumbers."
            },
            "src": "../../media/OChem_17_11_001.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00002",
          "segmentId": "m00210:para:para-00002"
        },
        {
          "type": "figure",
          "id": "fig-00002",
          "class": "scaled-down",
          "caption": {
            "segmentId": "m00210:caption:fig-00002-caption"
          },
          "media": {
            "alt": {
              "segmentId": "m00210:alt:fig-00002-alt",
              "text": "I R spectrum of phenol. Sharp peaks around 1500 and 1600 are associated with benzene ring, broad peak around 3400 wavenumbers labeled O H."
            },
            "src": "../../media/OChem_17_11_002.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
