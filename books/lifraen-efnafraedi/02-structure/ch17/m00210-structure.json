          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00210:alt:fig-00004-alt",
              "text": "A reversible reaction in which an alcohol reacts with deuterium oxide; hydroxide hydrogen is replaced with deuterium."
            },
            "src": "../../media/OChem_17_11_005.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
