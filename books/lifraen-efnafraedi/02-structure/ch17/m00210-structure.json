          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00210:alt:fig-00003-alt",
              "text": "The structure of cyclohexanol with shifts for each carbon (starting from C 1 and proceeding clockwise): 69.5, 35.5, 24.4, 25.9."
            },
            "src": "../../media/OChem_17_11_004.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
