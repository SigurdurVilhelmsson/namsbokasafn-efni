          "media": {
            "alt": {
              "segmentId": "m00210:alt:fig-00005-alt",
              "text": "H N M R spectrum with signals at 0.93 (triplet, C 3 hydrogens), 1.56 (sextet, C 2 hydrogens), 3.17 (singlet, hydroxyl hydrogen), and 3.58 (triplet, C 1 hydrogens)."
            },
            "src": "../../media/OChem_17_11_006.jpg",
            "mimeType": "image/jpeg"
          }
