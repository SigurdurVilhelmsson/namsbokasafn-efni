      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00204:alt:fig-00010-alt",
          "text": "Methyl butanoate reacts with two equivalents of methyl magnesium bromide, then hydronium ion to form 2-methyl-2-pentanol and methanol."
        },
        "src": "../../media/OChem_17_05_009.jpg",
        "mimeType": "image/jpeg"
      }
