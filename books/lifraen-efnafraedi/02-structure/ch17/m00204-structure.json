    {
      "type": "figure",
      "id": "fig-00009",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00204:alt:fig-00009-alt",
          "text": "2-pentanone reacts with methyl magnesium bromide, then hydronium ion to form 2-methyl-2-pentanol. Acetone reacts with propylmagnesium bromide, then hydronium ion to form 2-methyl-2-pentanol."
        },
        "src": "../../media/OChem_17_05_008.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "figure",
