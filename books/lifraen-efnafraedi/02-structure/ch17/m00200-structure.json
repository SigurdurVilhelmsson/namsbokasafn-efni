    {
      "type": "figure",
      "id": "fig-00002",
      "class": "unnumbered",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00200:alt:fig-00002-alt",
          "text": "The structures of three alcohols. The old names include 2-methyl-2-pentanol, cis-1,4-cyclohexanediol, and 3-phenyl-2-butanol. The new names of these structures are 2-methylpentan-2-ol, cis-cyclohexane-1,4-diol, and 3-phenylbutan-2-ol."
        },
        "src": "../../media/OChem_17_01_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
