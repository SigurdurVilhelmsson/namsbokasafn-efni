      "class": "unnumbered",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00200:alt:fig-00003-alt",
          "text": "The structures of five alcohols named benzyl alcohol (phenylmethanol), allyl alcohol (2-propen-1-ol), tert-butyl alcohol (2-methyl-2-propanol), ethylene glycol (1,2-ethanediol) and glycerol (1,2,3-propanetriol)."
        },
        "src": "../../media/OChem_17_01_003.jpg",
        "mimeType": "image/jpeg"
      }
