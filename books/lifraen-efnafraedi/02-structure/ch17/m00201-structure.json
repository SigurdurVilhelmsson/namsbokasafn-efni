      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00201:alt:fig-00003-alt",
          "text": "A reversible reaction in which alcohol reacts with water to form alkoxide ion and hydronium ions. Phenol reacts with water to form phenoxide ion and hydronium ion."
        },
        "src": "../../media/OChem_17_02_003.jpg",
        "mimeType": "image/jpeg"
