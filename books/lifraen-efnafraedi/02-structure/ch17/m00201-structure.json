      "media": {
        "alt": {
          "segmentId": "m00201:alt:fig-00004-alt",
          "text": "The ball-and-stick model of methoxide and tertiary-butoxide ion with p k a values. The oxygen of methoxide ion is sterically accessible, less hindered, and more easily solvated than tertiary-butoxide ion."
        },
        "src": "../../media/OChem_17_02_005.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00008",
