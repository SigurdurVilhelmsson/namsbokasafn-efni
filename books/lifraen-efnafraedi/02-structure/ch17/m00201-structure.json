    },
    {
      "type": "figure",
      "id": "fig-00005",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00201:alt:fig-00005-alt",
          "text": "t-butoxide with fluorines replacing all hydrogens has a lower p K a (5.4) than t-butoxide (18)."
        },
        "src": "../../media/OChem_17_02_006.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
