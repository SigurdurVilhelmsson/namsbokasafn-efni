      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00201:alt:fig-00002-alt",
          "text": "Alcohol reacts reversibly with alkyl halide to form oxonium ion (R O H 2 plus). Aryl alcohol reacts with alkyl halide to form aryl oxonium and halide."
        },
        "src": "../../media/OChem_17_02_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
