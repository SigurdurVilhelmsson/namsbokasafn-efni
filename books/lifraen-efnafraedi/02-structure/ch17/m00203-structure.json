              "segmentId": "m00203:para:para-00009"
            },
            {
              "type": "para",
              "id": "para-00010",
              "segmentId": "m00203:para:para-00010",
              "title": {
                "segmentId": "m00203:para-title:para-00010-title",
                "text": "Strategy"
              }
            },
            {
