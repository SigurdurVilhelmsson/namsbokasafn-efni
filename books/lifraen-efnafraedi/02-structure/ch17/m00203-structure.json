            }
          ]
        },
        {
          "type": "figure",
          "id": "fig-00009",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00203:alt:fig-00009-alt",
              "text": "Structure A is a condensed formula for 4-methylhexan-2-ol. Structure B is a condensed formula for trans-4-methylpent-2-en-1-ol."
            },
            "src": "../../media/OChem_17_04_009.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00010",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00203:alt:fig-00010-alt",
              "text": "4-methylhexan-2-one reacts first with sodium borohydride or lithium aluminum hydride, then with hydronium ion to form 4-methylhexan-2-ol."
            },
            "src": "../../media/OChem_17_04_010.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00011",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00203:alt:fig-00011-alt",
              "text": "Reactions of aldehyde, ester, and carboxylic acid derivatives of the same alkene. Each reacts with sodium borohydride or lithium aluminum hydride, then hydronium to form the same primary alcohol product."
            },
            "src": "../../media/OChem_17_04_011.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
