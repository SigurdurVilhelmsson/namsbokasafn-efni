        "alt": {
          "segmentId": "m00065:alt:fig-00005-alt",
          "text": "The structures of 1-methylcyclohexene, 1,4-cyclohexadiene (new name: cyclohexa-1,4-diene) and 1,5-dimethylcyclopentene. The carbon atoms are numbered in all structures."
        },
        "src": "../../media/OChem_07_03_005.jpg",
        "mimeType": "image/jpeg"
      }
    },
