{
  "moduleId": "m00073",
  "title": {
    "segmentId": "m00073:title:auto-1",
    "text": "Evidence for the Mechanism of Electrophilic Additions: Carbocation Rearrangements"
  },
  "documentClass": null,
  "metadata": {
    "uuid": "1b32e2c3-3422-4dc2-8e58-edbfa055e1f5"
  },
  "content": [
    {
      "type": "para",
      "id": "para-00001",
      "segmentId": "m00073:para:para-00001"
    },
    {
      "type": "para",
      "id": "para-00002",
      "segmentId": "m00073:para:para-00002"
    },
    {
      "type": "figure",
      "id": "fig-00001",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00073:alt:fig-00001-alt",
          "text": "3-methyl-1-butene reacts with hydrogen chloride to form 2-chloro-3-methylbutane (approximately 50 percent) and 2-chloro-2-methylbutane (approximately 50 percent)."
        },
        "src": "../../media/OChem_07_11_001.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00003",
      "segmentId": "m00073:para:para-00003"
    },
    {
      "type": "figure",
      "id": "fig-00002",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00073:alt:fig-00002-alt",
          "text": "3-methyl-1-butene reacts with hydrogen chloride to yield a secondary carbocation or (via hydride shift) a tertiary carbocation. These react with chloride to yield 2-chloro-3-methylbutane and 2-chloro-2-methylbutane, respectively."
        },
        "src": "../../media/OChem_07_11_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00004",
      "segmentId": "m00073:para:para-00004"
    },
    {
      "type": "figure",
      "id": "fig-00003",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00073:alt:fig-00003-alt",
          "text": "3,3-dimethyl-1-butene reacts with hydrogen chloride to yield a secondary carbocation or (via methyl shift) a tertiary carbocation. These react with chloride to yield 3-chloro-2,2-dimethylbutane and 2-chloro-2,3-dimethylbutane, respectively."
        },
        "src": "../../media/OChem_07_11_003.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00005",
      "segmentId": "m00073:para:para-00005"
    },
    {
      "type": "figure",
      "id": "fig-00004",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00073:alt:fig-00004-alt",
          "text": "A tertiary carbocation undergoes hydride shift to form an isomeric tertiary carbocation. Dotted circle denotes the hydride shift in reactant and product"
        },
        "src": "../../media/OChem_07_11_004.jpg",
        "mimeType": "image/jpeg"
      }
    },
