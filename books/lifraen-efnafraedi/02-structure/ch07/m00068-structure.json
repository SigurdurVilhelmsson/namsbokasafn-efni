      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00068:alt:fig-00001-alt",
          "text": "A reaction shows trans-but-2-ene and cis-but-2-ene interconvert in acid catalyst to reach a 76 to 24 percent ratio."
        },
        "src": "../../media/OChem_07_06_001.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00002",
