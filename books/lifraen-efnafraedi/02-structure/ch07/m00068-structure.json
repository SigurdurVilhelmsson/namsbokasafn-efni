    },
    {
      "type": "figure",
      "id": "fig-00002",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00068:alt:fig-00002-alt",
          "text": "The space-filling models of cis-2-butene and trans-2-butene. The gray and white spheres represent carbon and hydrogen atoms, respectively. Steric strain is shown between methyl groups in cis-2-butene."
        },
        "src": "../../media/OChem_07_06_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00003",
      "segmentId": "m00068:para:para-00003"
    },
    {
      "type": "figure",
      "id": "fig-00003",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00068:alt:fig-00003-alt",
          "text": "Trans-2-butene and cis-2-butene, each react with molecular hydrogen in the presence of palladium catalyst to form butane."
        },
        "src": "../../media/OChem_07_06_003.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00004",
      "segmentId": "m00068:para:para-00004"
    },
    {
      "type": "figure",
      "id": "fig-00004",
      "class": "scaled-down",
      "caption": {
        "segmentId": "m00068:caption:fig-00004-caption"
      },
      "media": {
        "alt": {
          "segmentId": "m00068:alt:fig-00004-alt",
          "text": "An energy diagram for the formation of butane from cis- and trans-2-butene. Cis is higher in energy than trans, and both are higher in energy than butane."
        },
        "src": "../../media/OChem_07_06_004.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
