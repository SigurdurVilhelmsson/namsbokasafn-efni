      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00063:alt:fig-00002-alt",
          "text": "An alkane consisting of 2 to 8 carbons undergoes steam cracking at 850-900 degrees Celsius to form hydrogen, ethene, propene, and butene."
        },
        "src": "../../media/OChem_07_01_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
