      "segmentId": "m00342:para:para-00003"
    },
    {
      "type": "figure",
      "id": "fig-00002",
      "class": "scaled-down",
      "caption": {
        "segmentId": "m00342:caption:fig-00002-caption"
      },
      "media": {
        "alt": {
          "segmentId": "m00342:alt:fig-00002-alt",
          "text": "(2E,4Z,6E)-2,4,6-octatriene reacts with heat to give cis-5,6-dimethyl-1,3-cyclohexadiene. (2E,4Z,6E)-2,4,6-octatriene reacts with light to give trans-5,6-dimethyl-1,3-cyclohexadiene. (2E,4Z,6Z)-2,4,6-octatriene reacts with heat to give trans-5,6-dimethyl-1,3-cyclohexadiene."
        },
        "src": "../../media/OChem_30_02_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00004",
      "segmentId": "m00342:para:para-00004"
    },
    {
      "type": "figure",
      "id": "fig-00003",
      "class": "scaled-down",
      "caption": {
        "segmentId": "m00342:caption:fig-00003-caption"
      },
      "media": {
        "alt": {
          "segmentId": "m00342:alt:fig-00003-alt",
          "text": "Cis-3,4-dimethyl-cyclobutene reacts with heat to form (2E,4Z)-2,4-hexadiene. Cis-3,4-dimethyl-cyclobutene reacts with light to form (2E,4E)-2,4-hexadiene. Trans-3,4-dimethylcyclobutene reacts with heat to form (2E,4E)-2,4-hexadiene."
        },
        "src": "../../media/OChem_30_02_003.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00005",
      "segmentId": "m00342:para:para-00005"
    },
    {
      "type": "figure",
      "id": "fig-00004",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00342:alt:fig-00004-alt",
          "text": "Two orbital pictures in which one figure has like lobes on the same side. The other figure has like lobes on the opposite side. The figures are separated by or."
        },
        "src": "../../media/OChem_30_02_004.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00006",
