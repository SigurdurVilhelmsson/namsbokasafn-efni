      "media": {
        "alt": {
          "segmentId": "m00342:alt:fig-00001-alt",
          "text": "Two chemical reactions occuring in the presence of heat. A conjugated triene forms 1,3-cyclohexadiene. A conjugated diene forms cyclobutene."
        },
        "src": "../../media/OChem_30_02_001.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00002",
