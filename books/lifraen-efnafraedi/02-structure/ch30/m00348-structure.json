        }
      ]
    },
    {
      "type": "para",
      "id": "para-00008",
      "segmentId": "m00348:para:para-00008"
    },
    {
      "type": "figure",
      "id": "fig-00006",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00348:alt:fig-00006-alt",
          "text": "1,5-hexadien-3-ol reacts with K H to form deprotonated trans-1,5-hexadien-1-ol. This reacts with hydronium to form 5-hexenal."
        },
        "src": "../../media/OChem_30_08_HOKH.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00009",
      "segmentId": "m00348:para:para-00009"
    },
    {
      "type": "figure",
      "id": "fig-00007",
      "class": "scaled-down",
      "caption": {
        "segmentId": "m00348:caption:fig-00007-caption"
      },
      "media": {
        "alt": {
          "segmentId": "m00348:alt:fig-00007-alt",
          "text": "Two reactions with orbital diagrams. The first shows Cope rearrangement of a 1,5-hexadiene (suprafacial). The second shows the Claisen rearrangement of an allylic vinylic ether (suprafacial)."
        },
        "src": "../../media/OChem_30_08_005.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "figure",
      "id": "fig-00008",
      "class": "scaled-down",
      "caption": {
        "segmentId": "m00348:caption:fig-00008-caption"
      },
      "media": {
        "alt": {
          "segmentId": "m00348:alt:fig-00008-alt",
          "text": "Chorismate reacts to form prephenate. The release of carbon dioxide and water leads to phenylpyruvate. This reacts with glutamate and alpha ketoglutarate to form phenylalanine."
        },
        "src": "../../media/OChem_30_08_006.jpg",
        "mimeType": "image/jpeg"
      }
    },
