    {
      "type": "figure",
      "id": "fig-00001",
      "class": "scaled-down",
      "caption": {
        "segmentId": "m00346:caption:fig-00001-caption"
      },
      "media": {
        "alt": {
          "segmentId": "m00346:alt:fig-00001-alt",
          "text": "The orbital structures of diene LUMO with alkene HOMO through suprafacial addition form cyclohexene. Addition is suprafacial because lobe signs match."
        },
        "src": "../../media/OChem_30_06_001.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00003",
      "segmentId": "m00346:para:para-00003"
    },
    {
      "type": "para",
      "id": "para-00004",
      "segmentId": "m00346:para:para-00004"
    },
    {
      "type": "figure",
      "id": "fig-00002",
      "class": "scaled-down",
      "caption": {
        "segmentId": "m00346:caption:fig-00002-caption"
      },
      "media": {
        "alt": {
          "segmentId": "m00346:alt:fig-00002-alt",
          "text": "Ground state LUMO and HOMO (thermal) react antarafacially but form no product due to strain. Excited state HOMO and ground state LUMO (photochemical) react suprafacially to form cyclobutane."
        },
        "src": "../../media/OChem_30_06_002.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00005",
      "segmentId": "m00346:para:para-00005"
    },
    {
      "type": "figure",
      "id": "fig-00003",
      "class": "unnumbered scaled-down",
      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00346:alt:fig-00003-alt",
          "text": "2-cyclohexanone reacts with 2-methylpropene and light to form cyclohexanone fused with cyclobutane; there is a methyl group on a wedge bond at each ortho-fused carbon. 40% yield."
        },
        "src": "../../media/OChem_30_06_003.jpg",
        "mimeType": "image/jpeg"
      }
    },
