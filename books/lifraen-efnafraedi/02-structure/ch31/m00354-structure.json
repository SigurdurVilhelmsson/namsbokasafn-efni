      "title": {
        "segmentId": "m00354:title:sect-00001-title",
        "text": "Polycarbonates"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00002",
          "segmentId": "m00354:para:para-00002"
        },
        {
          "type": "figure",
          "id": "fig-00002",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00354:alt:fig-00002-alt",
              "text": "Diphenyl carbonate reacts with bisphenol A at 300 degree Celsius to give Lexan and two n moles of phenol. Lexan's structure is inside parentheses with n as the subscript."
            },
            "src": "../../media/OChem_31_04_002.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
    {
      "type": "section",
      "id": "sect-00002",
      "class": null,
      "title": {
        "segmentId": "m00354:title:sect-00002-title",
        "text": "Polyurethanes"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00003",
          "segmentId": "m00354:para:para-00003"
        },
        {
          "type": "figure",
          "id": "fig-00003",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00354:alt:fig-00003-alt",
              "text": "Structures of a carbonate (carbonyl with two O R groups), a urate (carbonyl with O R and N R 2), and a urea (carbonyl with two N R 2 groups)."
            },
            "src": "../../media/OChem_31_04_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
