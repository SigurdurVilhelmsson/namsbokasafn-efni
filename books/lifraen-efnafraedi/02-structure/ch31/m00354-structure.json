          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00354:alt:fig-00004-alt",
              "text": "A polymer bonded with two alcohol groups on both sides reacts with toluene-2,4-diisocyanate to form polyurethane. Polyurethane's structure is inside parentheses with n as the subscript."
            },
            "src": "../../media/OChem_31_04_004.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
