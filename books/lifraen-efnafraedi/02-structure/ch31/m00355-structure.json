      "caption": null,
      "media": {
        "alt": {
          "segmentId": "m00355:alt:fig-00001-alt",
          "text": "An alkene with two R groups reacts with an alkene with two R prime groups in presence of catalyst forming two alkene products each with R and R prime groups."
        },
        "src": "../../media/OChem_31_05_001.jpg",
        "mimeType": "image/jpeg"
      }
    },
    {
      "type": "para",
      "id": "para-00002",
