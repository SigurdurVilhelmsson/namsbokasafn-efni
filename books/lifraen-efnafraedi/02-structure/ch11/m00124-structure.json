      "title": {
        "segmentId": "m00124:title:sect-00004-title",
        "text": "The Leaving Group"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00015",
          "segmentId": "m00124:para:para-00015"
        },
        {
          "type": "figure",
