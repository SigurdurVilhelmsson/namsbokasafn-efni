          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00124:alt:fig-00009-alt",
              "text": "A reaction of a primary or secondary alcohol with para-toluenesulfonyl chloride in the presence of ether and pyridine yields a tosylate."
            },
            "src": "../../media/OChem_11_03_009.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00018",
          "segmentId": "m00124:para:para-00018"
        },
        {
          "type": "figure",
          "id": "fig-00010",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00124:alt:fig-00010-alt",
              "text": "A reaction mechanism of propene oxide with hydrogen chloride produces a protonated epoxide intermediate, which reacts by S N 2 to form 1-chloro-2-propanol."
            },
            "src": "../../media/OChem_11_03_010.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
