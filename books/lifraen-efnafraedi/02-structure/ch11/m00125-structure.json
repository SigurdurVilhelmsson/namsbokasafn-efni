      "media": {
        "alt": {
          "segmentId": "m00125:alt:fig-00001-alt",
          "text": "The figure shows a reaction between R-Br and water yields R-OH and hydrogen bromide. The reactivity of substrate in increasing order is: methyl, primary, secondary, and tertiary."
        },
        "src": "../../media/OChem_11_04_001.jpg",
