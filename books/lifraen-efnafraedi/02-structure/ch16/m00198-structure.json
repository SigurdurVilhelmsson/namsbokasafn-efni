        {
          "type": "figure",
          "id": "fig-00015",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00015-alt",
              "text": "Benzene reacts with a fluorinating agent to form fluorobenzene."
            },
            "src": "../../media/OChem_16_EC_002.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00016",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00016-alt",
              "text": "Benzene reacts with bromine in the presence of iron tribromide to yield bromobenzene and hydrogen bromide."
            },
            "src": "../../media/OChem_16_EC_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00017",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00017-alt",
              "text": "Benzene reacts with chlorine in the presence of iron trichloride to form chlorobenzene and hydrochloric acid."
            },
            "src": "../../media/OChem_16_EC_004.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00018",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00018-alt",
              "text": "Benzene reacts with iodine in the presence of copper (2) chloride to form iodobenzene and hydrogen iodide."
            },
            "src": "../../media/OChem_16_EC_005.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00019",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00019-alt",
              "text": "Benzene reacts with nitric acid in the presence of sulfuric acid to form nitrobenzene and water."
            },
            "src": "../../media/OChem_16_EC_006.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00020",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00020-alt",
              "text": "Benzene reacts with sulfur trioxide in the presence of sulfuric acid to form benzene bonded to S O 3 H group."
            },
            "src": "../../media/OChem_16_EC_007.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00021",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00021-alt",
              "text": "Benzene reacts with methyl chloride in the presence of aluminum trichloride to form methyl benzene and hydrogen chloride."
            },
            "src": "../../media/OChem_16_EC_008.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00022",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00022-alt",
              "text": "Benzene reacts with acetyl chloride in the presence of aluminum trichloride to form benzene bonded to an acetyl group and hydrogen chloride."
            },
            "src": "../../media/OChem_16_EC_009.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00023",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00023-alt",
              "text": "Nitrobenzene reacts with iron in the presence of acid in step 1, and base in step 2 to form a benzene ring bonded to an amino group."
            },
            "src": "../../media/OChem_16_EC_010.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00024",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00024-alt",
              "text": "Benzene with three nitro groups and a chlorine atom reacts with sodium hydroxide to form benzene with three nitro groups and a hydroxyl group."
            },
            "src": "../../media/OChem_16_EC_011.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00025",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00025-alt",
              "text": "Bromobenzene reacts with sodium amide in the presence of ammonia to form aniline and sodium bromide."
            },
            "src": "../../media/OChem_16_EC_012.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00026",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00198:alt:fig-00026-alt",
              "text": "In water, toluene reacts with potassium permanganate to form benzoic acid."
            },
            "src": "../../media/OChem_16_EC_013.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
