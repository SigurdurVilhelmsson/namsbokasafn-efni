            "src": "../../media/OChem_21_EC_013.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00019",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00248:alt:fig-00019-alt",
              "text": "The reaction of an acid anhydride with an alcohol forms an ester and a carboxylic acid."
