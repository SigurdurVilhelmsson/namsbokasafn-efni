            "src": "../../media/OChem_21_EC_012.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00018",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00248:alt:fig-00018-alt",
              "text": "Reaction of an acid anhydride with water gives two equivalents of carboxylic acid."
