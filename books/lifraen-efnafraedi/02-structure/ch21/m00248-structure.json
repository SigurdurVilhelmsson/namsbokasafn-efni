          "id": "fig-00021",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00248:alt:fig-00021-alt",
              "text": "An ester is hydrolyzed to a carboxylic acid and alcohol using either acid or base."
