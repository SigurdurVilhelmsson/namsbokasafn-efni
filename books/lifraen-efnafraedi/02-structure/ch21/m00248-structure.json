            "src": "../../media/OChem_21_EC_011.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00017",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00248:alt:fig-00017-alt",
              "text": "An acid chloride reacts with diorganocopper-lithium (Gilman reagent) in ether to form an ester."
