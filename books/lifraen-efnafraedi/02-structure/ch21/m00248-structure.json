          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00248:alt:fig-00022-alt",
              "text": "An ester is reduced to an alcohol using lithium aluminum hydride in ether followed by treatment with acid."
            },
            "src": "../../media/OChem_21_EC_017.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
