          "media": {
            "alt": {
              "segmentId": "m00248:alt:fig-00008-alt",
              "text": "At the top, reaction of a carboxylate ion with an alkyl halide to give an ester through an S N 2 mechanism. At the bottom, reaction of a carboxylic acid with an alcohol to yield an ester."
            },
            "src": "../../media/OChem_21_EC_003.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
