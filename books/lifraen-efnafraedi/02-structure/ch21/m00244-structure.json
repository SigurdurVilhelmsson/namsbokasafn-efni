          "class": null,
          "title": {
            "segmentId": "m00244:title:sect-00008-title",
            "text": "Conversion of Esters into Alcohols: Grignard Reaction"
          },
          "content": [
            {
              "type": "para",
              "id": "para-00018",
              "segmentId": "m00244:para:para-00018"
            },
            {
              "type": "figure",
              "id": "fig-00014",
              "class": "unnumbered scaled-down",
              "caption": null,
              "media": {
                "alt": {
                  "segmentId": "m00244:alt:fig-00014-alt",
                  "text": "Methyl benzoate reacts with two moles of phenyl magnesium bromide followed by acid hydrolysis forming a product with tetrahedral carbon single-bonded to three benzene rings and hydroxyl (triphenylmethanol (ninety-six percent))."
                },
                "src": "../../media/OChem_21_06_016.jpg",
                "mimeType": "image/jpeg"
              }
            }
          ]
        },
