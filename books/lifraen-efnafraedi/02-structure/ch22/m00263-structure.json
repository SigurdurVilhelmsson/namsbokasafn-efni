    {
      "type": "section",
      "id": "sect-00010",
      "class": "summary",
      "title": {
        "segmentId": "m00263:title:sect-00010-title",
        "text": "Summary"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00038",
          "segmentId": "m00263:para:para-00038"
        },
        {
