    {
      "type": "section",
      "id": "sect-00005",
      "class": null,
      "title": {
        "segmentId": "m00263:title:sect-00005-title",
        "text": "Direct Alkylation of Ketones, Esters, and Nitriles"
      },
      "content": [
        {
          "type": "para",
          "id": "para-00027",
          "segmentId": "m00263:para:para-00027"
        },
        {
          "type": "para",
          "id": "para-00028",
          "segmentId": "m00263:para:para-00028"
        },
        {
          "type": "figure",
          "id": "fig-00017",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00263:alt:fig-00017-alt",
              "text": "Butyrolactone reacts with L D A in T H F to form an intermediate, which reacts with methyl iodide to form 2-methylbutyrolactone in 88 percent yield."
            },
            "src": "../../media/OChem_22_07_021.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00034",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00263:alt:fig-00034-alt",
              "text": "Ethyl 2-methylpropanoate reacts with L D A in T H F  to form an intermediate, which reacts with methyl iodide to form ethyl 2,2-dimethylpropanoatein 87 percent yield."
            },
            "src": "../../media/OChem_22_07_022.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00035",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00263:alt:fig-00035-alt",
              "text": "2-Methylcyclohexanone reacts with L D A in T H F to form two intermediates, which react with methyl iodide to form 2,6-dimethylcyclohexanone (56 percent) and 2,2-dimethylcyclohexanone (6 percent), respectively."
            },
            "src": "../../media/OChem_22_07_023.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "para",
          "id": "para-00029",
          "segmentId": "m00263:para:para-00029"
        },
        {
