          "id": "exam-00003",
          "title": {
            "segmentId": "m00263:example-title:exam-00003-title",
            "text": "Using an Alkylation Reaction to Prepare a Substituted Ester"
          },
          "content": [
            {
              "type": "para",
              "id": "para-00030",
