                "text": "Solution"
              }
            }
          ]
        },
        {
          "type": "figure",
          "id": "fig-00018",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00263:alt:fig-00018-alt",
              "text": "The structure of ethyl 1-methylcyclohexanecarboxylate in which both C O 2 E t and C H 3 groups are bonded to C 1 of cyclohexane."
            },
            "src": "../../media/OChem_22_07_025.jpg",
            "mimeType": "image/jpeg"
          }
        },
        {
          "type": "figure",
          "id": "fig-00019",
          "class": "unnumbered scaled-down",
          "caption": null,
          "media": {
            "alt": {
              "segmentId": "m00263:alt:fig-00019-alt",
              "text": "Ethyl cyclohexanecarboxylate reacts with L D A in T H F in one step and methyl iodide in a second step to yield ethyl 1-methylcyclohexanecarboxylate."
            },
            "src": "../../media/OChem_22_07_026.jpg",
            "mimeType": "image/jpeg"
          }
        }
      ]
    },
