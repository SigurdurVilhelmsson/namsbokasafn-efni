        "alt": {
          "segmentId": "m00060:alt:fig-00002-alt",
          "text": "2-Butanone is labeled Si face (counterclockwise) at the bottom and Re face (clockwise) at the top. To the right, the structures of (S)-2-butanol and (R)-2-butanol are drawn."
        },
        "src": "../../media/OChem_05_11_002.jpg",
        "mimeType": "image/jpeg"
      }
